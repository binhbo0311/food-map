@startuml seq_06_gps
skinparam monochrome true
skinparam shadowing false
skinparam backgroundColor white
skinparam defaultFontSize 12
skinparam sequenceArrowColor black
skinparam sequenceParticipantBorderColor black
skinparam sequenceParticipantBackgroundColor white
skinparam sequenceLifeLineBorderColor black
skinparam sequenceGroupBorderColor black
skinparam noteBackgroundColor white
skinparam noteBorderColor black
autonumber

title UC-06: Sequence - GPS Geofence & Tour Recording

actor "User" as U
participant "LocationForegroundService" as LOC
participant "GeofenceMath" as GEO
participant "NarrationService" as TTS
participant "API / DB" as API

LOC -> LOC : StartForeground() -- Android ForegroundService starts
LOC -> LOC : RequestLocationUpdates every 5s

loop Every location update
    LOC -> GEO : CalculateDistanceMeters(userLat, userLng, poiLat, poiLng)
    GEO --> LOC : distanceMeters

    alt distanceMeters <= poi.ActivationRadius
        LOC -> LOC : Check debounce (min 2 hits) and cooldown (90s)

        opt Debounce passed & cooldown cleared
            LOC -> TTS : PlayProximityNarrationAsync(ttsScript, lang)
            TTS --> U : [Audio] "You are approaching {POI name}"
            LOC -> API : POST /user-tours { userId, poiId, trigger: "proximity" }
            API --> LOC : 201 Created
            LOC -> LOC : Show notification: "Triggered POI #{id}"
        end
    else Out of radius
        LOC -> LOC : Reset debounce counter for this POI
    end
end
@enduml
