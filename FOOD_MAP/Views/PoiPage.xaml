<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FOOD_MAP.PoiPage"
             BackgroundColor="#EAF8F8"
             Title="POI">
    <Grid RowDefinitions="Auto,*" Padding="16">
        <VerticalStackLayout Spacing="8">
            <Label Text="Nearby POI" FontSize="28" FontAttributes="Bold" TextColor="#143536" />
            <Label Text="Favorited items luôn được ghim lên đầu, sau đó mới đến khoảng cách gần nhất." TextColor="#4D6B6C" />
            <Button Text="Refresh" CornerRadius="14" BackgroundColor="#0B949A" TextColor="White" Clicked="OnRefreshClicked" />
        </VerticalStackLayout>

        <CollectionView Grid.Row="1" ItemsSource="{Binding PoiItems}" SelectionMode="None" Margin="0,16,0,0">
            <CollectionView.EmptyView>
                <Label Text="Chưa có POI nào để hiển thị." TextColor="#4D6B6C" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Stroke="#A9E1E2" StrokeThickness="1" BackgroundColor="White" Margin="0,0,0,10" Padding="10">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="18" />
                        </Border.StrokeShape>
                        <Grid ColumnDefinitions="92,*,Auto" ColumnSpacing="12">
                            <Border HeightRequest="92" WidthRequest="92" StrokeThickness="0" BackgroundColor="#F2FBFB">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="16" />
                                </Border.StrokeShape>
                                <Image Source="{Binding ImageUrl}" Aspect="AspectFill" />
                            </Border>

                            <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                                <Label Text="{Binding Title}" FontSize="16" FontAttributes="Bold" TextColor="#143536" LineBreakMode="TailTruncation" />
                                <Label Text="{Binding DistanceLabel, StringFormat='Khoảng cách: {0}'}" FontSize="12" TextColor="#4D6B6C" />
                                <Label Text="{Binding PriorityLabel, StringFormat='Priority: {0}'}" FontSize="12" TextColor="#066D72" />
                                <Label Text="{Binding IsFavorite, StringFormat='Fav: {0}'}" FontSize="12" TextColor="#9A6B00" />
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Column="2" HorizontalOptions="End" VerticalOptions="Center" Spacing="6">
                                <Label Text="{Binding IsFavorite, StringFormat='Favorite: {0}'}" TextColor="#9A6B00" FontAttributes="Bold" HorizontalTextAlignment="End" />
                                <Label Text="{Binding PoiType}" TextColor="#066D72" HorizontalTextAlignment="End" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>