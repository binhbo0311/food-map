<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:FOOD_MAP.ViewModels"
             x:Class="FOOD_MAP.TourPage"
             BackgroundColor="#EAF8F8"
             Title="Tour">
    <RefreshView Command="{Binding RefreshCommand}" IsRefreshing="{Binding IsRefreshing}">
        <Grid Padding="14,10,14,16" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="12">
            <VerticalStackLayout Spacing="4">
                <Label Text="Chọn tour để xem lộ trình" FontSize="20" FontAttributes="Bold" TextColor="#143536" />
                <Label Text="Tour chỉ hiển thị danh sách để xem trước, sau đó chọn một tour để mở POI tương ứng." TextColor="#4D6B6C" />
            </VerticalStackLayout>

            <CollectionView Grid.Row="1"
                            ItemsSource="{Binding TourSummaries}"
                            SelectionMode="Single"
                            SelectedItem="{Binding SelectedTour, Mode=TwoWay}"
                            SelectionChanged="OnTourSelectionChanged"
                            HeightRequest="120">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Horizontal" ItemSpacing="12" />
                </CollectionView.ItemsLayout>
                <CollectionView.EmptyView>
                    <Label Text="Chưa có Tour nào trong TourList." TextColor="#4D6B6C" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Stroke="#A9E1E2"
                                StrokeThickness="1"
                                BackgroundColor="White"
                                Margin="0,0,0,10"
                                Padding="14"
                                WidthRequest="220">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="18" />
                            </Border.StrokeShape>

                            <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="4">
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="{Binding DisplayName}" FontSize="16" FontAttributes="Bold" TextColor="#143536" />
                                    <Label Text="{Binding TourCode, StringFormat='Tour code: {0}'}" FontSize="12" TextColor="#4D6B6C" />
                                    <Label Text="{Binding SummaryText}" FontSize="12" TextColor="#066D72" />
                                </VerticalStackLayout>

                                <Label Grid.Row="1"
                                       Text="{Binding PoiCount, StringFormat='Số POI: {0}'}"
                                       FontSize="12"
                                       TextColor="#4D6B6C" />

                                <Border Grid.Row="2"
                                        HorizontalOptions="Start"
                                        Padding="10,6"
                                        BackgroundColor="#E8F7F8"
                                        StrokeThickness="0">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="10" />
                                    </Border.StrokeShape>
                                    <Label Text="Xem tour" FontSize="11" TextColor="#066D72" />
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Border Grid.Row="2"
                    IsVisible="{Binding HasSelectedTour}"
                    Stroke="#A9E1E2"
                    StrokeThickness="1"
                    BackgroundColor="White"
                    Padding="12">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="18" />
                </Border.StrokeShape>

                <Grid RowDefinitions="220,Auto,Auto,Auto,Auto" RowSpacing="10">
                    <Border StrokeThickness="0" BackgroundColor="#F2FBFB">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16" />
                        </Border.StrokeShape>
                        <Image Source="{Binding SelectedTourPoiImageUrl}" Aspect="AspectFill" />
                    </Border>

                    <VerticalStackLayout Grid.Row="1" Spacing="4">
                        <Label Text="{Binding SelectedTourDisplayName}" FontSize="18" FontAttributes="Bold" TextColor="#143536" />
                        <Label Text="{Binding SelectedTourSummaryText}" FontSize="12" TextColor="#4D6B6C" />
                    </VerticalStackLayout>

                        <Grid Grid.Row="2" ColumnDefinitions="Auto,Auto,Auto" ColumnSpacing="8">
                        <Button Grid.Column="0"
                            Text="Play"
                            HeightRequest="44"
                            CornerRadius="14"
                            BackgroundColor="#066D72"
                            TextColor="White"
                            HorizontalOptions="Start"
                            Clicked="OnPlayClicked" />

                        <Button Grid.Column="1"
                            Text="Sửa"
                            HeightRequest="44"
                            CornerRadius="14"
                            BackgroundColor="#D6ECEC"
                            TextColor="#143536"
                            IsVisible="{Binding CanManageSelectedTour}"
                            Clicked="OnEditTourClicked" />

                        <Button Grid.Column="2"
                            Text="Xóa"
                            HeightRequest="44"
                            CornerRadius="14"
                            BackgroundColor="#D94A4A"
                            TextColor="White"
                            IsVisible="{Binding CanManageSelectedTour}"
                            Clicked="OnDeleteTourClicked" />
                        </Grid>

                    <Label Grid.Row="3"
                           Text="{Binding SelectedTourPoiDescription}"
                           FontSize="13"
                           TextColor="#4D6B6C" />

                    <CollectionView Grid.Row="4"
                                    ItemsSource="{Binding TourPois}"
                                    SelectionMode="Single"
                                    SelectedItem="{Binding SelectedTourPoi, Mode=TwoWay}"
                                    SelectionChanged="OnTourPoiSelectionChanged"
                                    HeightRequest="190">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Horizontal" ItemSpacing="12" />
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="viewModels:PoiListItemViewModel">
                                <Border WidthRequest="170"
                                        Stroke="#A9E1E2"
                                        StrokeThickness="1"
                                        BackgroundColor="#F2FBFB"
                                        Padding="8">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="14" />
                                    </Border.StrokeShape>

                                    <VerticalStackLayout Spacing="6">
                                        <Border HeightRequest="92" StrokeThickness="0" BackgroundColor="White">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="12" />
                                            </Border.StrokeShape>
                                            <Image Source="{Binding ImageUrl}" Aspect="AspectFill" />
                                        </Border>

                                        <Label Text="{Binding Name}" FontSize="13" FontAttributes="Bold" TextColor="#143536" LineBreakMode="TailTruncation" />
                                        <Label Text="{Binding Description}" FontSize="11" TextColor="#4D6B6C" LineBreakMode="TailTruncation" />
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Grid>
            </Border>

            <Label Grid.Row="3" Text="{Binding StatusMessage}" FontSize="12" TextColor="#4D6B6C" />
        </Grid>
    </RefreshView>
</ContentPage>