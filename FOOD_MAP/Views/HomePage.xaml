<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FOOD_MAP.HomePage"
             BackgroundColor="#EAF8F8"
             Title="Home">
    <RefreshView Command="{Binding RefreshCommand}" IsRefreshing="{Binding IsRefreshing}">
        <ScrollView>
            <VerticalStackLayout Spacing="14" Padding="16,10,16,24">
                <CollectionView ItemsSource="{Binding Sections}" SelectionMode="None">
                    <CollectionView.EmptyView>
                        <Label Text="Chưa có POI để hiển thị." TextColor="#4D6B6C" />
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <VerticalStackLayout Spacing="10" Margin="0,0,0,12">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <Label Text="{Binding Title}" FontSize="18" FontAttributes="Bold" TextColor="#143536" />
                                </Grid>

                                <CollectionView ItemsSource="{Binding Items}"
                                                SelectionMode="None"
                                                ItemsLayout="HorizontalList"
                                                HeightRequest="230">
                                    <CollectionView.ItemTemplate>
                                        <DataTemplate>
                                            <Border WidthRequest="280"
                                                    Stroke="#A9E1E2"
                                                    StrokeThickness="1"
                                                    BackgroundColor="White"
                                                    Margin="0,0,12,0"
                                                    Padding="10">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="18" />
                                                </Border.StrokeShape>

                                                <Grid RowDefinitions="130,Auto" RowSpacing="8">
                                                    <Border StrokeThickness="0" BackgroundColor="#F2FBFB">
                                                        <Border.StrokeShape>
                                                            <RoundRectangle CornerRadius="14" />
                                                        </Border.StrokeShape>
                                                        <Image Source="{Binding ImageUrl}" Aspect="AspectFill" />
                                                    </Border>

                                                    <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                        <VerticalStackLayout Spacing="2">
                                                            <Label Text="{Binding Title}" FontSize="15" FontAttributes="Bold" TextColor="#143536" LineBreakMode="TailTruncation" />
                                                            <Label Text="{Binding Description}" FontSize="12" TextColor="#4D6B6C" LineBreakMode="TailTruncation" />
                                                            <Label Text="{Binding DistanceLabel, StringFormat='Khoảng cách: {0}'}" FontSize="11" TextColor="#4D6B6C" />
                                                        </VerticalStackLayout>

                                                        <Border Grid.Column="1" Padding="8,4" BackgroundColor="#E8F7F8" StrokeThickness="0">
                                                            <Border.StrokeShape>
                                                                <RoundRectangle CornerRadius="10" />
                                                            </Border.StrokeShape>
                                                            <Label Text="{Binding PriorityLabel}" FontSize="11" TextColor="#066D72" />
                                                        </Border>
                                                    </Grid>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>
                            </VerticalStackLayout>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <VerticalStackLayout Spacing="8">
                    <Label Text="Tour" FontSize="18" FontAttributes="Bold" TextColor="#143536" />
                    <CollectionView ItemsSource="{Binding TourSummaries}"
                                    SelectionMode="Single"
                                    SelectionChanged="OnTourSelectionChanged"
                                    HeightRequest="132">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Horizontal" ItemSpacing="10" />
                        </CollectionView.ItemsLayout>
                        <CollectionView.EmptyView>
                            <Label Text="Chưa có tour. Hãy bấm Tạo tour." TextColor="#4D6B6C" />
                        </CollectionView.EmptyView>
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border WidthRequest="230"
                                        Stroke="#A9E1E2"
                                        StrokeThickness="1"
                                        BackgroundColor="White"
                                        Padding="10">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="16" />
                                    </Border.StrokeShape>

                                    <VerticalStackLayout Spacing="4">
                                        <Label Text="{Binding DisplayName}" FontSize="14" FontAttributes="Bold" TextColor="#143536" LineBreakMode="TailTruncation" />
                                        <Label Text="{Binding SummaryText}" FontSize="12" TextColor="#066D72" />
                                        <Label Text="{Binding TourCode}" FontSize="11" TextColor="#4D6B6C" LineBreakMode="TailTruncation" />
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>

                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                    <Button Grid.Column="0"
                        Text="Tạo tour tự động"
                        CornerRadius="16"
                        BackgroundColor="#FF4F9A"
                        TextColor="White"
                        HeightRequest="46"
                        Clicked="OnCreateTourClicked" />

                    <Button Grid.Column="1"
                        Text="Tạo tour tùy chỉnh"
                        CornerRadius="16"
                        BackgroundColor="#066D72"
                        TextColor="White"
                        HeightRequest="46"
                        Clicked="OnCreateCustomTourClicked" />
                </Grid>

                <Label Text="{Binding StatusMessage}" TextColor="#4D6B6C" FontSize="12" />
            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>
</ContentPage>