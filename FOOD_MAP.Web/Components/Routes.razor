@using FOOD_MAP.Shared.Layout
@using SharedPages = FOOD_MAP.Shared.Pages

<Router AppAssembly="typeof(App).Assembly"
        AdditionalAssemblies="new[] { typeof(FOOD_MAP.Shared._Imports).Assembly }"
        NotFoundPage="typeof(SharedPages.NotFound)">
    <Found Context="routeData">
        <RouteView RouteData="routeData" DefaultLayout="typeof(MainLayout)" />
        <FocusOnNavigate RouteData="routeData" Selector="h1" />
    </Found>
</Router>
