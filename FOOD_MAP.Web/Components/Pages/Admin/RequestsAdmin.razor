@page "/admin/requests"
@using FOOD_MAP.Shared.Data
@using FOOD_MAP.Shared.Models
@using FOOD_MAP.Shared.Services
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<AppDbContext> DbContextFactory
@inject IPoiWorkflowRepository PoiWorkflowRepository

<PageTitle>Workflow Requests Admin</PageTitle>

<AdminRoleGate>

<h1>Workflow Requests Admin</h1>
<p class="text-muted">Review owner registration, language ownership, and pending POI submissions in one place.</p>

<div class="d-flex flex-wrap gap-2 mb-3">
    <a class="btn btn-outline-secondary" href="/admin">Open Admin Dashboard</a>
    <a class="btn btn-outline-primary" href="/admin/poi">Open POI Admin</a>
</div>

@if (!string.IsNullOrWhiteSpace(statusMessage))
{
    <div class="alert @(isErrorStatus ? "alert-danger" : "alert-success")" role="alert">
        @statusMessage
    </div>
}

@if (isBusy)
{
    <p>Loading...</p>
}
else
{
    <section class="border rounded p-3 mb-3 bg-white">
        <h2 class="h5 mb-3">Pending Owner Registration Requests</h2>

        <div class="row g-2 mb-3">
            <div class="col-md-4">
                <label class="form-label">Search</label>
                <InputText @bind-Value="ownerSearchKeyword" class="form-control" placeholder="User, business, phone..." />
            </div>
            <div class="col-md-2">
                <label class="form-label">Sort By</label>
                <InputSelect @bind-Value="ownerSortField" class="form-select">
                    <option value="id">Request Id</option>
                    <option value="user">User</option>
                    <option value="business">Business</option>
                    <option value="phone">Phone</option>
                    <option value="requested">Requested UTC</option>
                </InputSelect>
            </div>
            <div class="col-md-2">
                <label class="form-label">Dir</label>
                <InputSelect @bind-Value="ownerSortDirection" class="form-select">
                    <option value="asc">Asc</option>
                    <option value="desc">Desc</option>
                </InputSelect>
            </div>
            <div class="col-md-2">
                <label class="form-label">Page Size</label>
                <InputSelect @bind-Value="ownerPageSize" class="form-select">
                    @foreach (var size in GridPageSizeOptions)
                    {
                        <option value="@size">@size</option>
                    }
                </InputSelect>
            </div>
            <div class="col-md-2 d-flex align-items-end">
                <button type="button" class="btn btn-outline-secondary w-100" @onclick="ResetOwnerFilters">Clear</button>
            </div>
        </div>

        @{
            var filteredOwnerRequests = GetFilteredOwnerRequests();
            var ownerTotalPages = GetOwnerTotalPages(filteredOwnerRequests.Count);
            var safeOwnerPage = Math.Clamp(ownerPageIndex, 1, ownerTotalPages);
            var pagedOwnerRequests = filteredOwnerRequests
                .Skip((safeOwnerPage - 1) * ownerPageSize)
                .Take(ownerPageSize)
                .ToList();
        }

        @if (filteredOwnerRequests.Count == 0)
        {
            <p class="text-muted mb-0">No owner registration request matches current filters.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle mb-2">
                    <thead>
                        <tr>
                            <th>Request Id</th>
                            <th>User</th>
                            <th>Business</th>
                            <th>Phone</th>
                            <th>Requested (UTC)</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var request in pagedOwnerRequests)
                        {
                            <tr>
                                <td>@request.Id</td>
                                <td>@request.User?.DisplayName (@request.User?.UserName)</td>
                                <td>@request.BusinessName</td>
                                <td>@request.ContactPhone</td>
                                <td>@request.RequestedUtc.ToString("yyyy-MM-dd HH:mm:ss")</td>
                                <td class="text-end">
                                    <button class="btn btn-sm btn-outline-success me-2" @onclick="() => ApproveOwnerRequestAsync(request.Id)">Approve</button>
                                    <button class="btn btn-sm btn-outline-danger" @onclick="() => RejectOwnerRequestAsync(request.Id)">Reject</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="d-flex justify-content-between align-items-center">
                <small class="text-muted">Showing @pagedOwnerRequests.Count of @filteredOwnerRequests.Count result(s).</small>
                <div class="btn-group">
                    <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@(safeOwnerPage <= 1)" @onclick="() => MoveOwnerPage(-1)">Previous</button>
                    <button type="button" class="btn btn-sm btn-outline-secondary" disabled>Page @safeOwnerPage / @ownerTotalPages</button>
                    <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@(safeOwnerPage >= ownerTotalPages)" @onclick="() => MoveOwnerPage(1)">Next</button>
                </div>
            </div>
        }
    </section>

    <section class="border rounded p-3 mb-3 bg-white">
        <h2 class="h5 mb-3">Pending Language Ownership Requests</h2>

        <div class="row g-2 mb-3">
            <div class="col-md-4">
                <label class="form-label">Search</label>
                <InputText @bind-Value="languageSearchKeyword" class="form-control" placeholder="Owner or language..." />
            </div>
            <div class="col-md-2">
                <label class="form-label">Sort By</label>
                <InputSelect @bind-Value="languageSortField" class="form-select">
                    <option value="id">Request Id</option>
                    <option value="owner">Owner</option>
                    <option value="language">Language</option>
                    <option value="requested">Requested UTC</option>
                </InputSelect>
            </div>
            <div class="col-md-2">
                <label class="form-label">Dir</label>
                <InputSelect @bind-Value="languageSortDirection" class="form-select">
                    <option value="asc">Asc</option>
                    <option value="desc">Desc</option>
                </InputSelect>
            </div>
            <div class="col-md-2">
                <label class="form-label">Page Size</label>
                <InputSelect @bind-Value="languagePageSize" class="form-select">
                    @foreach (var size in GridPageSizeOptions)
                    {
                        <option value="@size">@size</option>
                    }
                </InputSelect>
            </div>
            <div class="col-md-2 d-flex align-items-end">
                <button type="button" class="btn btn-outline-secondary w-100" @onclick="ResetLanguageFilters">Clear</button>
            </div>
        </div>

        @{
            var filteredLanguageRequests = GetFilteredLanguageRequests();
            var languageTotalPages = GetLanguageTotalPages(filteredLanguageRequests.Count);
            var safeLanguagePage = Math.Clamp(languagePageIndex, 1, languageTotalPages);
            var pagedLanguageRequests = filteredLanguageRequests
                .Skip((safeLanguagePage - 1) * languagePageSize)
                .Take(languagePageSize)
                .ToList();
        }

        @if (filteredLanguageRequests.Count == 0)
        {
            <p class="text-muted mb-0">No language ownership request matches current filters.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle mb-2">
                    <thead>
                        <tr>
                            <th>Request Id</th>
                            <th>Owner</th>
                            <th>Language</th>
                            <th>Requested (UTC)</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var request in pagedLanguageRequests)
                        {
                            <tr>
                                <td>@request.Id</td>
                                <td>@request.OwnerUser?.DisplayName (@request.OwnerUser?.UserName)</td>
                                <td>@request.Language?.LanguageName (@request.Language?.LanguageCode)</td>
                                <td>@request.RequestedUtc.ToString("yyyy-MM-dd HH:mm:ss")</td>
                                <td class="text-end">
                                    <button class="btn btn-sm btn-outline-success me-2" @onclick="() => ApproveLanguageOwnershipRequestAsync(request.Id)">Approve</button>
                                    <button class="btn btn-sm btn-outline-danger" @onclick="() => RejectLanguageOwnershipRequestAsync(request.Id)">Reject</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="d-flex justify-content-between align-items-center">
                <small class="text-muted">Showing @pagedLanguageRequests.Count of @filteredLanguageRequests.Count result(s).</small>
                <div class="btn-group">
                    <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@(safeLanguagePage <= 1)" @onclick="() => MoveLanguagePage(-1)">Previous</button>
                    <button type="button" class="btn btn-sm btn-outline-secondary" disabled>Page @safeLanguagePage / @languageTotalPages</button>
                    <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@(safeLanguagePage >= languageTotalPages)" @onclick="() => MoveLanguagePage(1)">Next</button>
                </div>
            </div>
        }
    </section>

    <section class="border rounded p-3 bg-white">
        <h2 class="h5 mb-3">Pending POI Approvals</h2>

        <div class="row g-2 mb-3">
            <div class="col-md-4">
                <label class="form-label">Search</label>
                <InputText @bind-Value="poiSearchKeyword" class="form-control" placeholder="POI id, owner, type..." />
            </div>
            <div class="col-md-2">
                <label class="form-label">POI Type</label>
                <InputSelect @bind-Value="poiTypeFilter" class="form-select">
                    <option value="">All</option>
                    <option value="Food">Food</option>
                    <option value="Visit">Visit</option>
                </InputSelect>
            </div>
            <div class="col-md-2">
                <label class="form-label">Sort By</label>
                <InputSelect @bind-Value="poiSortField" class="form-select">
                    <option value="id">POI Id</option>
                    <option value="type">Type</option>
                    <option value="owner">Owner</option>
                    <option value="submitted">Submitted UTC</option>
                </InputSelect>
            </div>
            <div class="col-md-2">
                <label class="form-label">Dir</label>
                <InputSelect @bind-Value="poiSortDirection" class="form-select">
                    <option value="asc">Asc</option>
                    <option value="desc">Desc</option>
                </InputSelect>
            </div>
            <div class="col-md-1">
                <label class="form-label">Page Size</label>
                <InputSelect @bind-Value="poiPageSize" class="form-select">
                    @foreach (var size in GridPageSizeOptions)
                    {
                        <option value="@size">@size</option>
                    }
                </InputSelect>
            </div>
            <div class="col-md-1 d-flex align-items-end">
                <button type="button" class="btn btn-outline-secondary w-100" @onclick="ResetPoiFilters">Clear</button>
            </div>
        </div>

        @{
            var filteredPendingPois = GetFilteredPendingPois();
            var poiTotalPages = GetPoiTotalPages(filteredPendingPois.Count);
            var safePoiPage = Math.Clamp(poiPageIndex, 1, poiTotalPages);
            var pagedPendingPois = filteredPendingPois
                .Skip((safePoiPage - 1) * poiPageSize)
                .Take(poiPageSize)
                .ToList();
        }

        @if (filteredPendingPois.Count == 0)
        {
            <p class="text-muted mb-0">No pending POI matches current filters.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle mb-2">
                    <thead>
                        <tr>
                            <th>POI Id</th>
                            <th>Type</th>
                            <th>Owner</th>
                            <th>Submitted (UTC)</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var pendingPoi in pagedPendingPois)
                        {
                            <tr>
                                <td>@pendingPoi.Id</td>
                                <td>@pendingPoi.Type</td>
                                <td>@pendingPoi.Owner?.DisplayName (@pendingPoi.Owner?.UserName)</td>
                                <td>@pendingPoi.SubmittedUtc.ToString("yyyy-MM-dd HH:mm:ss")</td>
                                <td class="text-end">
                                    <button class="btn btn-sm btn-outline-success me-2" @onclick="() => ApprovePendingPoiAsync(pendingPoi.Id)">Approve</button>
                                    <button class="btn btn-sm btn-outline-danger" @onclick="() => RejectPendingPoiAsync(pendingPoi.Id)">Reject</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="d-flex justify-content-between align-items-center">
                <small class="text-muted">Showing @pagedPendingPois.Count of @filteredPendingPois.Count result(s).</small>
                <div class="btn-group">
                    <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@(safePoiPage <= 1)" @onclick="() => MovePoiPage(-1)">Previous</button>
                    <button type="button" class="btn btn-sm btn-outline-secondary" disabled>Page @safePoiPage / @poiTotalPages</button>
                    <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@(safePoiPage >= poiTotalPages)" @onclick="() => MovePoiPage(1)">Next</button>
                </div>
            </div>
        }
    </section>
}

</AdminRoleGate>

@code {
    private readonly List<OwnerRegistrationRequest> pendingOwnerRequests = [];
    private readonly List<LanguageOwnershipRequest> pendingLanguageOwnershipRequests = [];
    private readonly List<POI> pendingPoiItems = [];

    private bool isBusy;
    private bool isErrorStatus;
    private string statusMessage = string.Empty;

    private string ownerSearchKeyword = string.Empty;
    private string ownerSortField = "requested";
    private string ownerSortDirection = "desc";
    private int ownerPageSize = 10;
    private int ownerPageIndex = 1;

    private string languageSearchKeyword = string.Empty;
    private string languageSortField = "requested";
    private string languageSortDirection = "desc";
    private int languagePageSize = 10;
    private int languagePageIndex = 1;

    private string poiSearchKeyword = string.Empty;
    private string poiTypeFilter = string.Empty;
    private string poiSortField = "submitted";
    private string poiSortDirection = "desc";
    private int poiPageSize = 10;
    private int poiPageIndex = 1;

    private static readonly int[] GridPageSizeOptions = [5, 10, 20, 50];

    protected override async Task OnInitializedAsync()
    {
        await LoadPendingRequestsAsync();
    }

    private async Task LoadPendingRequestsAsync()
    {
        isBusy = true;
        statusMessage = string.Empty;

        try
        {
            pendingOwnerRequests.Clear();
            pendingLanguageOwnershipRequests.Clear();
            pendingPoiItems.Clear();

            var ownerRequests = await PoiWorkflowRepository.GetPendingOwnerRegistrationRequestsAsync();
            pendingOwnerRequests.AddRange(ownerRequests);

            var languageOwnershipRequests = await PoiWorkflowRepository.GetPendingLanguageOwnershipRequestsAsync();
            pendingLanguageOwnershipRequests.AddRange(languageOwnershipRequests);

            var pendingPois = await PoiWorkflowRepository.GetPendingPoisAsync();
            pendingPoiItems.AddRange(pendingPois);

            isErrorStatus = false;
            statusMessage = "Pending workflow lists loaded.";
        }
        catch (Exception ex)
        {
            isErrorStatus = true;
            statusMessage = $"Unable to load pending workflow requests: {ex.Message}";
        }
        finally
        {
            isBusy = false;
        }
    }

    private async Task ApproveOwnerRequestAsync(int requestId)
    {
        var adminUserId = await ResolveAdminUserIdAsync();
        if (adminUserId <= 0)
        {
            isErrorStatus = true;
            statusMessage = "No admin user was found to review this request.";
            return;
        }

        var result = await PoiWorkflowRepository.ApproveOwnerRegistrationAsync(requestId, adminUserId);
        isErrorStatus = !result.IsSuccess;
        statusMessage = result.Message;
        await LoadPendingRequestsAsync();
    }

    private async Task RejectOwnerRequestAsync(int requestId)
    {
        var adminUserId = await ResolveAdminUserIdAsync();
        if (adminUserId <= 0)
        {
            isErrorStatus = true;
            statusMessage = "No admin user was found to review this request.";
            return;
        }

        var result = await PoiWorkflowRepository.RejectOwnerRegistrationAsync(requestId, adminUserId, "Rejected from admin portal.");
        isErrorStatus = !result.IsSuccess;
        statusMessage = result.Message;
        await LoadPendingRequestsAsync();
    }

    private async Task ApproveLanguageOwnershipRequestAsync(int requestId)
    {
        var adminUserId = await ResolveAdminUserIdAsync();
        if (adminUserId <= 0)
        {
            isErrorStatus = true;
            statusMessage = "No admin user was found to review this language request.";
            return;
        }

        var result = await PoiWorkflowRepository.ApproveLanguageOwnershipRequestAsync(requestId, adminUserId);
        isErrorStatus = !result.IsSuccess;
        statusMessage = result.Message;
        await LoadPendingRequestsAsync();
    }

    private async Task RejectLanguageOwnershipRequestAsync(int requestId)
    {
        var adminUserId = await ResolveAdminUserIdAsync();
        if (adminUserId <= 0)
        {
            isErrorStatus = true;
            statusMessage = "No admin user was found to review this language request.";
            return;
        }

        var result = await PoiWorkflowRepository.RejectLanguageOwnershipRequestAsync(
            requestId,
            adminUserId,
            "Rejected from admin portal.");

        isErrorStatus = !result.IsSuccess;
        statusMessage = result.Message;
        await LoadPendingRequestsAsync();
    }

    private async Task ApprovePendingPoiAsync(string poiId)
    {
        var adminUserId = await ResolveAdminUserIdAsync();
        if (adminUserId <= 0)
        {
            isErrorStatus = true;
            statusMessage = "No admin user was found to review this POI.";
            return;
        }

        var result = await PoiWorkflowRepository.ApprovePoiAsync(poiId, adminUserId);
        isErrorStatus = !result.IsSuccess;
        statusMessage = result.Message;
        await LoadPendingRequestsAsync();
    }

    private async Task RejectPendingPoiAsync(string poiId)
    {
        var adminUserId = await ResolveAdminUserIdAsync();
        if (adminUserId <= 0)
        {
            isErrorStatus = true;
            statusMessage = "No admin user was found to review this POI.";
            return;
        }

        var result = await PoiWorkflowRepository.RejectPoiAsync(poiId, adminUserId);
        isErrorStatus = !result.IsSuccess;
        statusMessage = result.Message;
        await LoadPendingRequestsAsync();
    }

    private async Task<int> ResolveAdminUserIdAsync()
    {
        await using var dbContext = await DbContextFactory.CreateDbContextAsync();
        var adminUserId = await dbContext.Users
            .AsNoTracking()
            .Where(x => x.Role == UserRole.Admin)
            .OrderBy(x => x.Id)
            .Select(x => x.Id)
            .FirstOrDefaultAsync();

        if (adminUserId > 0)
        {
            return adminUserId;
        }

        return await dbContext.Users
            .AsNoTracking()
            .OrderBy(x => x.Id)
            .Select(x => x.Id)
            .FirstOrDefaultAsync();
    }

    private List<OwnerRegistrationRequest> GetFilteredOwnerRequests()
    {
        IEnumerable<OwnerRegistrationRequest> query = pendingOwnerRequests;

        if (!string.IsNullOrWhiteSpace(ownerSearchKeyword))
        {
            var keyword = ownerSearchKeyword.Trim();
            query = query.Where(x =>
                x.Id.ToString().Contains(keyword, StringComparison.OrdinalIgnoreCase)
                || (x.User?.DisplayName?.Contains(keyword, StringComparison.OrdinalIgnoreCase) ?? false)
                || (x.User?.UserName?.Contains(keyword, StringComparison.OrdinalIgnoreCase) ?? false)
                || x.BusinessName.Contains(keyword, StringComparison.OrdinalIgnoreCase)
                || x.ContactPhone.Contains(keyword, StringComparison.OrdinalIgnoreCase));
        }

        var sortDescending = string.Equals(ownerSortDirection, "desc", StringComparison.OrdinalIgnoreCase);
        query = ownerSortField.ToLowerInvariant() switch
        {
            "id" => sortDescending ? query.OrderByDescending(x => x.Id) : query.OrderBy(x => x.Id),
            "user" => sortDescending
                ? query.OrderByDescending(x => x.User?.DisplayName ?? string.Empty).ThenByDescending(x => x.User?.UserName ?? string.Empty)
                : query.OrderBy(x => x.User?.DisplayName ?? string.Empty).ThenBy(x => x.User?.UserName ?? string.Empty),
            "business" => sortDescending ? query.OrderByDescending(x => x.BusinessName) : query.OrderBy(x => x.BusinessName),
            "phone" => sortDescending ? query.OrderByDescending(x => x.ContactPhone) : query.OrderBy(x => x.ContactPhone),
            _ => sortDescending ? query.OrderByDescending(x => x.RequestedUtc) : query.OrderBy(x => x.RequestedUtc)
        };

        return query.ToList();
    }

    private List<LanguageOwnershipRequest> GetFilteredLanguageRequests()
    {
        IEnumerable<LanguageOwnershipRequest> query = pendingLanguageOwnershipRequests;

        if (!string.IsNullOrWhiteSpace(languageSearchKeyword))
        {
            var keyword = languageSearchKeyword.Trim();
            query = query.Where(x =>
                x.Id.ToString().Contains(keyword, StringComparison.OrdinalIgnoreCase)
                || (x.OwnerUser?.DisplayName?.Contains(keyword, StringComparison.OrdinalIgnoreCase) ?? false)
                || (x.OwnerUser?.UserName?.Contains(keyword, StringComparison.OrdinalIgnoreCase) ?? false)
                || (x.Language?.LanguageCode?.Contains(keyword, StringComparison.OrdinalIgnoreCase) ?? false)
                || (x.Language?.LanguageName?.Contains(keyword, StringComparison.OrdinalIgnoreCase) ?? false));
        }

        var sortDescending = string.Equals(languageSortDirection, "desc", StringComparison.OrdinalIgnoreCase);
        query = languageSortField.ToLowerInvariant() switch
        {
            "id" => sortDescending ? query.OrderByDescending(x => x.Id) : query.OrderBy(x => x.Id),
            "owner" => sortDescending
                ? query.OrderByDescending(x => x.OwnerUser?.DisplayName ?? string.Empty).ThenByDescending(x => x.OwnerUser?.UserName ?? string.Empty)
                : query.OrderBy(x => x.OwnerUser?.DisplayName ?? string.Empty).ThenBy(x => x.OwnerUser?.UserName ?? string.Empty),
            "language" => sortDescending
                ? query.OrderByDescending(x => x.Language?.LanguageName ?? string.Empty).ThenByDescending(x => x.Language?.LanguageCode ?? string.Empty)
                : query.OrderBy(x => x.Language?.LanguageName ?? string.Empty).ThenBy(x => x.Language?.LanguageCode ?? string.Empty),
            _ => sortDescending ? query.OrderByDescending(x => x.RequestedUtc) : query.OrderBy(x => x.RequestedUtc)
        };

        return query.ToList();
    }

    private List<POI> GetFilteredPendingPois()
    {
        IEnumerable<POI> query = pendingPoiItems;

        if (!string.IsNullOrWhiteSpace(poiSearchKeyword))
        {
            var keyword = poiSearchKeyword.Trim();
            query = query.Where(x =>
                x.Id.Contains(keyword, StringComparison.OrdinalIgnoreCase)
                || (x.Owner?.DisplayName?.Contains(keyword, StringComparison.OrdinalIgnoreCase) ?? false)
                || (x.Owner?.UserName?.Contains(keyword, StringComparison.OrdinalIgnoreCase) ?? false)
                || x.Type.ToString().Contains(keyword, StringComparison.OrdinalIgnoreCase));
        }

        if (!string.IsNullOrWhiteSpace(poiTypeFilter) && Enum.TryParse<PoiType>(poiTypeFilter, true, out var filterType))
        {
            query = query.Where(x => x.Type == filterType);
        }

        var sortDescending = string.Equals(poiSortDirection, "desc", StringComparison.OrdinalIgnoreCase);
        query = poiSortField.ToLowerInvariant() switch
        {
            "id" => sortDescending ? query.OrderByDescending(x => x.Id) : query.OrderBy(x => x.Id),
            "type" => sortDescending ? query.OrderByDescending(x => x.Type) : query.OrderBy(x => x.Type),
            "owner" => sortDescending
                ? query.OrderByDescending(x => x.Owner != null ? x.Owner.DisplayName : string.Empty)
                : query.OrderBy(x => x.Owner != null ? x.Owner.DisplayName : string.Empty),
            _ => sortDescending ? query.OrderByDescending(x => x.SubmittedUtc) : query.OrderBy(x => x.SubmittedUtc)
        };

        return query.ToList();
    }

    private int GetOwnerTotalPages(int totalRows)
    {
        return GetTotalPages(totalRows, ownerPageSize);
    }

    private int GetLanguageTotalPages(int totalRows)
    {
        return GetTotalPages(totalRows, languagePageSize);
    }

    private int GetPoiTotalPages(int totalRows)
    {
        return GetTotalPages(totalRows, poiPageSize);
    }

    private static int GetTotalPages(int totalRows, int pageSize)
    {
        var safePageSize = Math.Max(1, pageSize);
        return Math.Max(1, (int)Math.Ceiling(totalRows / (double)safePageSize));
    }

    private void MoveOwnerPage(int delta)
    {
        var totalPages = GetOwnerTotalPages(GetFilteredOwnerRequests().Count);
        ownerPageIndex = Math.Clamp(ownerPageIndex + delta, 1, totalPages);
    }

    private void MoveLanguagePage(int delta)
    {
        var totalPages = GetLanguageTotalPages(GetFilteredLanguageRequests().Count);
        languagePageIndex = Math.Clamp(languagePageIndex + delta, 1, totalPages);
    }

    private void MovePoiPage(int delta)
    {
        var totalPages = GetPoiTotalPages(GetFilteredPendingPois().Count);
        poiPageIndex = Math.Clamp(poiPageIndex + delta, 1, totalPages);
    }

    private void ResetOwnerFilters()
    {
        ownerSearchKeyword = string.Empty;
        ownerSortField = "requested";
        ownerSortDirection = "desc";
        ownerPageSize = 10;
        ownerPageIndex = 1;
    }

    private void ResetLanguageFilters()
    {
        languageSearchKeyword = string.Empty;
        languageSortField = "requested";
        languageSortDirection = "desc";
        languagePageSize = 10;
        languagePageIndex = 1;
    }

    private void ResetPoiFilters()
    {
