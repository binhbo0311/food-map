@page "/admin/translations"
@using FOOD_MAP.Shared.Data
@using FOOD_MAP.Shared.Models
@using Microsoft.EntityFrameworkCore
@using System.ComponentModel.DataAnnotations
@inject IDbContextFactory<AppDbContext> DbContextFactory

<PageTitle>Language & Translation Admin</PageTitle>

<AdminRoleGate>

<h1>Language & Translation Admin</h1>
<p class="text-muted">Manage supported languages and POI translations.</p>

<div class="d-flex flex-wrap gap-2 mb-3">
    <a class="btn btn-outline-secondary" href="/admin">Open Admin Dashboard</a>
    <a class="btn btn-outline-primary" href="/admin/poi">Open POI Admin</a>
</div>

@if (!string.IsNullOrWhiteSpace(statusMessage))
{
    <div class="alert @(isErrorStatus ? "alert-danger" : "alert-success")" role="alert">
        @statusMessage
    </div>
}

<ul class="nav nav-tabs mb-3" role="tablist">
    <li class="nav-item" role="presentation">
        <button type="button"
                class="nav-link @(activeTab == AdminTab.Language ? "active" : null)"
                @onclick="() => SwitchTab(AdminTab.Language)">
            Language Management
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button type="button"
                class="nav-link @(activeTab == AdminTab.Translation ? "active" : null)"
                @onclick="() => SwitchTab(AdminTab.Translation)">
            Translation Management
        </button>
    </li>
</ul>

@if (activeTab == AdminTab.Language)
{
    <section class="border rounded p-3 bg-light-subtle">
        <h2 class="h5 mb-3">Add Language</h2>

        <EditForm Model="languageFormModel" OnValidSubmit="HandleCreateLanguageAsync">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label">Language Code</label>
                    <InputText @bind-Value="languageFormModel.LanguageCode" class="form-control" placeholder="vi, en, ja..." />
                </div>

                <div class="col-md-8">
                    <label class="form-label">Language Name</label>
                    <InputText @bind-Value="languageFormModel.LanguageName" class="form-control" placeholder="Tiếng Việt, English..." />
                </div>
            </div>

            <button type="submit" class="btn btn-primary mt-3" disabled="@isBusy">Add Language</button>
        </EditForm>

        <hr />

        <h3 class="h6">Current Languages</h3>

        <div class="row g-2 mb-3">
            <div class="col-md-4">
                <label class="form-label">Search</label>
                <InputText @bind-Value="languageSearchKeyword" class="form-control" placeholder="Code or language name..." />
            </div>
            <div class="col-md-2">
                <label class="form-label">Sort By</label>
                <InputSelect @bind-Value="languageSortField" class="form-select">
                    <option value="name">Language Name</option>
                    <option value="code">Language Code</option>
                    <option value="id">Id</option>
                </InputSelect>
            </div>
            <div class="col-md-2">
                <label class="form-label">Dir</label>
                <InputSelect @bind-Value="languageSortDirection" class="form-select">
                    <option value="asc">Asc</option>
                    <option value="desc">Desc</option>
                </InputSelect>
            </div>
            <div class="col-md-2">
                <label class="form-label">Page Size</label>
                <InputSelect @bind-Value="languagePageSize" class="form-select">
                    @foreach (var size in GridPageSizeOptions)
                    {
                        <option value="@size">@size</option>
                    }
                </InputSelect>
            </div>
            <div class="col-md-2 d-flex align-items-end">
                <button type="button" class="btn btn-outline-secondary w-100" @onclick="ResetLanguageGrid">Clear</button>
            </div>
        </div>

        @{
            var filteredLanguages = GetFilteredLanguageItems();
            var languageTotalPages = GetLanguageTotalPages(filteredLanguages.Count);
            var safeLanguagePage = Math.Clamp(languagePageIndex, 1, languageTotalPages);
            var pagedLanguages = filteredLanguages
                .Skip((safeLanguagePage - 1) * languagePageSize)
                .Take(languagePageSize)
                .ToList();
        }

        @if (filteredLanguages.Count == 0)
        {
            <p class="text-muted mb-0">No languages yet.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle mb-2">
                    <thead>
                        <tr>
                            <th>Id</th>
                            <th>Language Name</th>
                            <th>Language Code</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var language in pagedLanguages)
                        {
                            <tr>
                                <td>@language.Id</td>
                                <td>@language.LanguageName</td>
                                <td><span class="badge bg-secondary">@language.LanguageCode</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="d-flex justify-content-between align-items-center">
                <small class="text-muted">Showing @pagedLanguages.Count of @filteredLanguages.Count result(s).</small>
                <div class="btn-group">
                    <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@(safeLanguagePage <= 1)" @onclick="() => MoveLanguagePage(-1)">Previous</button>
                    <button type="button" class="btn btn-sm btn-outline-secondary" disabled>Page @safeLanguagePage / @languageTotalPages</button>
                    <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@(safeLanguagePage >= languageTotalPages)" @onclick="() => MoveLanguagePage(1)">Next</button>
                </div>
            </div>
        }
    </section>
}
else
{
    <section class="border rounded p-3 bg-light-subtle">
        <h2 class="h5 mb-3">Add or Update Translation</h2>

        @if (poiItems.Count == 0)
        {
            <div class="alert alert-warning mb-0" role="alert">
                No POI found. Please create POI first in Admin POI.
            </div>
        }
        else if (languageItems.Count == 0)
        {
            <div class="alert alert-warning mb-0" role="alert">
                No language available. Please add a language first.
            </div>
        }
        else
        {
            <EditForm Model="translationFormModel" OnValidSubmit="HandleSaveTranslationAsync">
                <DataAnnotationsValidator />
                <ValidationSummary />

                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">POI</label>
                        <InputSelect @bind-Value="translationFormModel.PoiId" class="form-select">
                            <option value="">-- Select POI --</option>
                            @foreach (var poi in poiItems)
                            {
                                <option value="@poi.Id">@poi.DisplayName</option>
                            }
                        </InputSelect>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Language</label>
                        <InputSelect @bind-Value="translationFormModel.LanguageId" class="form-select">
                            <option value="0">-- Select Language --</option>
                            @foreach (var language in languageItems)
                            {
                                <option value="@language.Id">@language.LanguageName (@language.LanguageCode)</option>
                            }
                        </InputSelect>
                    </div>

                    <div class="col-12">
                        <label class="form-label">Location Name</label>
                        <InputText @bind-Value="translationFormModel.LocationName" class="form-control" />
                    </div>

                    <div class="col-12">
                        <label class="form-label">Description</label>
                        <InputTextArea @bind-Value="translationFormModel.Description" class="form-control" rows="4" />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Image Url</label>
                        <InputText @bind-Value="translationFormModel.ImageUrl" class="form-control" />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Audio Url</label>
                        <InputText @bind-Value="translationFormModel.AudioFileUrl" class="form-control" />
                    </div>

                    <div class="col-12">
                        <label class="form-label">TTS Script</label>
                        <InputTextArea @bind-Value="translationFormModel.TtsScript" class="form-control" rows="3" />
                    </div>

                    <div class="col-12">
                        <label class="form-label">Rich Content (HTML/text)</label>
                        <InputTextArea @bind-Value="translationFormModel.RichContentHtml" class="form-control" rows="6" />
                    </div>
                </div>

                <div class="d-flex gap-2 mt-3">
                    <button type="submit" class="btn btn-primary" disabled="@isBusy">
                        @(isEditMode ? "Update Translation" : "Save Translation")
                    </button>
                    <button type="button" class="btn btn-secondary" @onclick="ResetTranslationEditor" disabled="@isBusy">Reset</button>
                </div>
            </EditForm>
        }
    </section>

    <section class="border rounded p-3 bg-white mt-3">
        <h2 class="h5 mb-3">Translations</h2>

        <div class="row g-2 mb-3">
            <div class="col-md-4">
                <label class="form-label">Keyword</label>
                <InputText @bind-Value="translationSearchKeyword" class="form-control" placeholder="Search by POI, language, name..." />
            </div>
            <div class="col-md-3">
                <label class="form-label">Filter POI</label>
                <InputSelect @bind-Value="translationPoiFilterId" class="form-select">
                    <option value="">All POI</option>
                    @foreach (var poi in poiItems)
                    {
                        <option value="@poi.Id">@poi.DisplayName</option>
                    }
                </InputSelect>
            </div>
            <div class="col-md-3">
                <label class="form-label">Filter Language</label>
                <InputSelect @bind-Value="translationLanguageFilterId" class="form-select">
                    <option value="0">All Languages</option>
                    @foreach (var language in languageItems)
                    {
                        <option value="@language.Id">@language.LanguageName (@language.LanguageCode)</option>
                    }
                </InputSelect>
            </div>
            <div class="col-md-2">
                <label class="form-label">Sort By</label>
                <InputSelect @bind-Value="translationSortField" class="form-select">
                    <option value="id">Id</option>
                    <option value="poi">POI</option>
                    <option value="language">Language</option>
                    <option value="name">Name</option>
                </InputSelect>
            </div>
            <div class="col-md-2">
                <label class="form-label">Dir</label>
                <InputSelect @bind-Value="translationSortDirection" class="form-select">
                    <option value="asc">Asc</option>
                    <option value="desc">Desc</option>
                </InputSelect>
            </div>
            <div class="col-md-1">
                <label class="form-label">Page</label>
                <InputSelect @bind-Value="translationPageSize" class="form-select">
                    @foreach (var size in GridPageSizeOptions)
                    {
                        <option value="@size">@size</option>
                    }
                </InputSelect>
            </div>
            <div class="col-md-2 d-flex align-items-end">
                <button type="button" class="btn btn-outline-secondary w-100" @onclick="ResetTranslationFilters">Clear</button>
            </div>
        </div>

        @{
            var filteredTranslations = GetFilteredTranslationItems();
            var translationTotalPages = GetTranslationTotalPages(filteredTranslations.Count);
            var safeTranslationPage = Math.Clamp(translationPageIndex, 1, translationTotalPages);
            var pagedTranslations = filteredTranslations
                .Skip((safeTranslationPage - 1) * translationPageSize)
                .Take(translationPageSize)
                .ToList();
        }

        @if (isBusy)
        {
            <p class="mb-0">Loading...</p>
        }
        else if (translationItems.Count == 0)
        {
            <p class="text-muted mb-0">No translation data yet.</p>
        }
        else if (filteredTranslations.Count == 0)
        {
            <p class="text-muted mb-0">No translation matches current filters.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Id</th>
                            <th>POI</th>
                            <th>Language</th>
                            <th>Name</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in pagedTranslations)
                        {
                            <tr>
                                <td>@item.Id</td>
                                <td>@item.PoiDisplayName</td>
                                <td>@item.LanguageName (@item.LanguageCode)</td>
                                <td>@item.LocationName</td>
                                <td class="text-end">
                                    <button class="btn btn-sm btn-outline-primary me-2" @onclick="() => StartEditTranslation(item)">Edit</button>
                                    <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteTranslationAsync(item.Id)">Delete</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="d-flex justify-content-between align-items-center mt-2">
                <small class="text-muted">Showing @pagedTranslations.Count of @filteredTranslations.Count result(s).</small>
                <div class="btn-group">
                    <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@(safeTranslationPage <= 1)" @onclick="() => MoveTranslationPage(-1)">Previous</button>
                    <button type="button" class="btn btn-sm btn-outline-secondary" disabled>Page @safeTranslationPage / @translationTotalPages</button>
                    <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@(safeTranslationPage >= translationTotalPages)" @onclick="() => MoveTranslationPage(1)">Next</button>
                </div>
            </div>
        }
    </section>
}

</AdminRoleGate>

@code {
    private readonly List<LanguageRow> languageItems = [];
    private readonly List<PoiOption> poiItems = [];
    private readonly List<TranslationRow> translationItems = [];

    private readonly LanguageFormModel languageFormModel = new();
    private readonly TranslationFormModel translationFormModel = new();

    private AdminTab activeTab = AdminTab.Translation;
    private bool isBusy;
    private bool isEditMode;
    private bool isErrorStatus;
    private int? editingTranslationId;
    private string languageSearchKeyword = string.Empty;
    private string languageSortField = "name";
    private string languageSortDirection = "asc";
    private int languagePageSize = 10;
    private int languagePageIndex = 1;
    private string translationSearchKeyword = string.Empty;
    private string translationPoiFilterId = string.Empty;
    private int translationLanguageFilterId;
    private string translationSortField = "poi";
    private string translationSortDirection = "asc";
    private int translationPageSize = 10;
    private int translationPageIndex = 1;
    private string statusMessage = string.Empty;

    private static readonly int[] GridPageSizeOptions = [5, 10, 20, 50];

    protected override async Task OnInitializedAsync()
    {
        await ReloadAllAsync();
    }

    private async Task ReloadAllAsync()
    {
        isBusy = true;
        statusMessage = string.Empty;

        try
        {
            await using var dbContext = await DbContextFactory.CreateDbContextAsync();

            var languages = await dbContext.Languages
                .AsNoTracking()
                .OrderBy(x => x.LanguageName)
                .Select(x => new LanguageRow
                {
                    Id = x.Id,
                    LanguageCode = x.LanguageCode,
                    LanguageName = x.LanguageName
                })
                .ToListAsync();

            var pois = await dbContext.Pois
                .AsNoTracking()
                .OrderBy(x => x.Priority)
                .ThenBy(x => x.Id)
                .Select(x => new PoiOption
                {
                    Id = x.Id,
                    DisplayName = x.PoiTranslations
                        .Where(t => t.Language != null && t.Language.LanguageCode == "vi")
                        .Select(t => t.LocationName)
                        .FirstOrDefault()
                        ?? x.PoiTranslations
                            .OrderBy(t => t.LanguageId)
                            .Select(t => t.LocationName)
                            .FirstOrDefault()
                        ?? $"POI #{x.Id}"
                })
                .ToListAsync();

            var translations = await dbContext.PoiTranslations
                .AsNoTracking()
                .Include(x => x.Language)
                .OrderBy(x => x.PoiId)
                .ThenBy(x => x.LanguageId)
                .Select(x => new TranslationRow
                {
                    Id = x.Id,
                    PoiId = x.PoiId,
                    LanguageId = x.LanguageId,
                    LanguageCode = x.Language != null ? x.Language.LanguageCode : string.Empty,
                    LanguageName = x.Language != null ? x.Language.LanguageName : string.Empty,
                    LocationName = x.LocationName,
                    Description = x.Description,
                    ImageUrl = x.ImageUrl,
                    AudioFileUrl = x.AudioFileUrl,
                    TtsScript = x.TtsScript,
                    RichContentHtml = x.RichContentHtml
                })
                .ToListAsync();

            var poiLookup = pois.ToDictionary(x => x.Id, x => x.DisplayName);
            foreach (var translation in translations)
            {
                translation.PoiDisplayName = poiLookup.TryGetValue(translation.PoiId, out var displayName)
                    ? displayName
                    : $"POI #{translation.PoiId}";
            }

            languageItems.Clear();
            languageItems.AddRange(languages);

            poiItems.Clear();
            poiItems.AddRange(pois);

            translationItems.Clear();
            translationItems.AddRange(translations);

            languagePageIndex = 1;
            translationPageIndex = 1;
        }
        catch (Exception ex)
        {
            isErrorStatus = true;
            statusMessage = $"Unable to load language/translation data: {ex.Message}";
        }
        finally
        {
            isBusy = false;
        }
    }

    private async Task HandleCreateLanguageAsync()
    {
        var code = languageFormModel.LanguageCode.Trim().ToLowerInvariant();
        var name = languageFormModel.LanguageName.Trim();

        if (string.IsNullOrWhiteSpace(code) || string.IsNullOrWhiteSpace(name))
        {
            isErrorStatus = true;
            statusMessage = "Language code and language name are required.";
            return;
        }

        isBusy = true;
        statusMessage = string.Empty;

        try
        {
            await using var dbContext = await DbContextFactory.CreateDbContextAsync();
            var exists = await dbContext.Languages.AnyAsync(x => x.LanguageCode.ToLower() == code);

            if (exists)
            {
                isErrorStatus = true;
                statusMessage = $"Language code '{code}' already exists.";
                return;
            }

            dbContext.Languages.Add(new Language
            {
                LanguageCode = code,
                LanguageName = name
            });

            await dbContext.SaveChangesAsync();

            isErrorStatus = false;
            statusMessage = $"Added language {name} ({code}).";

            languageFormModel.LanguageCode = string.Empty;
            languageFormModel.LanguageName = string.Empty;

            await ReloadAllAsync();
        }
        catch (Exception ex)
        {
            isErrorStatus = true;
            statusMessage = $"Unable to add language: {ex.Message}";
        }
        finally
        {
            isBusy = false;
        }
    }

    private async Task HandleSaveTranslationAsync()
    {
        if (string.IsNullOrWhiteSpace(translationFormModel.PoiId) || translationFormModel.LanguageId <= 0)
        {
            isErrorStatus = true;
            statusMessage = "Please choose both POI and language.";
            return;
        }

        var imageUrl = translationFormModel.ImageUrl.Trim();
        var audioFileUrl = translationFormModel.AudioFileUrl.Trim();
        if (!IsValidAbsoluteHttpUrl(imageUrl))
        {
            isErrorStatus = true;
            statusMessage = "Image Url must be a valid absolute URL (http/https).";
            return;
        }

        if (!IsValidAbsoluteHttpUrl(audioFileUrl))
        {
            isErrorStatus = true;
            statusMessage = "Audio Url must be a valid absolute URL (http/https).";
            return;
        }

        isBusy = true;
        statusMessage = string.Empty;

        try
        {
            await using var dbContext = await DbContextFactory.CreateDbContextAsync();

            var translation = await dbContext.PoiTranslations
                .FirstOrDefaultAsync(x => x.PoiId == translationFormModel.PoiId && x.LanguageId == translationFormModel.LanguageId);

            var isNewTranslation = translation is null;
            if (translation is null)
            {
                translation = new POITranslation
                {
                    PoiId = translationFormModel.PoiId,
                    LanguageId = translationFormModel.LanguageId
                };

                dbContext.PoiTranslations.Add(translation);
            }

            translation.LocationName = translationFormModel.LocationName.Trim();
            translation.Description = translationFormModel.Description.Trim();
            translation.ImageUrl = imageUrl;
            translation.AudioFileUrl = audioFileUrl;
            translation.TtsScript = translationFormModel.TtsScript.Trim();
            translation.RichContentHtml = translationFormModel.RichContentHtml.Trim();

            await dbContext.SaveChangesAsync();

            isErrorStatus = false;
            statusMessage = isNewTranslation
                ? "Translation created successfully."
                : "Translation updated successfully.";

            ResetTranslationEditor();
            await ReloadAllAsync();
        }
        catch (Exception ex)
        {
            isErrorStatus = true;
            statusMessage = $"Unable to save translation: {ex.Message}";
        }
        finally
        {
            isBusy = false;
        }
    }

    private void StartEditTranslation(TranslationRow item)
    {
        editingTranslationId = item.Id;
        isEditMode = true;

        translationFormModel.PoiId = item.PoiId;
        translationFormModel.LanguageId = item.LanguageId;
        translationFormModel.LocationName = item.LocationName;
        translationFormModel.Description = item.Description;
        translationFormModel.ImageUrl = item.ImageUrl;
        translationFormModel.AudioFileUrl = item.AudioFileUrl;
        translationFormModel.TtsScript = item.TtsScript;
        translationFormModel.RichContentHtml = item.RichContentHtml;

        isErrorStatus = false;
        statusMessage = $"Editing translation #{item.Id}.";
    }

    private async Task DeleteTranslationAsync(int translationId)
    {
        isBusy = true;
        statusMessage = string.Empty;

        try
        {
            await using var dbContext = await DbContextFactory.CreateDbContextAsync();
            var translation = await dbContext.PoiTranslations.FirstOrDefaultAsync(x => x.Id == translationId);

            if (translation is null)
            {
                isErrorStatus = true;
                statusMessage = "Translation no longer exists.";
                return;
            }

            dbContext.PoiTranslations.Remove(translation);
            await dbContext.SaveChangesAsync();

            if (editingTranslationId == translationId)
            {
                ResetTranslationEditor();
            }

            isErrorStatus = false;
            statusMessage = "Translation deleted successfully.";

            await ReloadAllAsync();
        }
        catch (Exception ex)
        {
            isErrorStatus = true;
            statusMessage = $"Unable to delete translation: {ex.Message}";
        }
        finally
        {
            isBusy = false;
        }
    }

    private void ResetTranslationEditor()
    {
        editingTranslationId = null;
        isEditMode = false;

        translationFormModel.PoiId = string.Empty;
        translationFormModel.LanguageId = 0;
        translationFormModel.LocationName = string.Empty;
        translationFormModel.Description = string.Empty;
        translationFormModel.ImageUrl = string.Empty;
        translationFormModel.AudioFileUrl = string.Empty;
        translationFormModel.TtsScript = string.Empty;
        translationFormModel.RichContentHtml = string.Empty;
    }

    private static bool IsValidAbsoluteHttpUrl(string url)
    {
        if (!Uri.TryCreate(url, UriKind.Absolute, out var uri))
        {
            return false;
        }

        return uri.Scheme == Uri.UriSchemeHttp || uri.Scheme == Uri.UriSchemeHttps;
    }

    private void SwitchTab(AdminTab tab)
    {
        activeTab = tab;
    }

    private void ResetTranslationFilters()
    {
        translationSearchKeyword = string.Empty;
        translationPoiFilterId = string.Empty;
        translationLanguageFilterId = 0;
        translationSortField = "poi";
        translationSortDirection = "asc";
        translationPageSize = 10;
        translationPageIndex = 1;
    }

    private List<TranslationRow> GetFilteredTranslationItems()
    {
        IEnumerable<TranslationRow> query = translationItems;

        if (!string.IsNullOrWhiteSpace(translationPoiFilterId))
        {
            query = query.Where(x => x.PoiId == translationPoiFilterId);
        }

        if (translationLanguageFilterId > 0)
        {
            query = query.Where(x => x.LanguageId == translationLanguageFilterId);
        }

        if (!string.IsNullOrWhiteSpace(translationSearchKeyword))
        {
            var keyword = translationSearchKeyword.Trim();
            query = query.Where(x =>
                x.PoiDisplayName.Contains(keyword, StringComparison.OrdinalIgnoreCase)
                || x.LanguageName.Contains(keyword, StringComparison.OrdinalIgnoreCase)
                || x.LanguageCode.Contains(keyword, StringComparison.OrdinalIgnoreCase)
                || x.LocationName.Contains(keyword, StringComparison.OrdinalIgnoreCase));
        }

        var sortDescending = string.Equals(translationSortDirection, "desc", StringComparison.OrdinalIgnoreCase);
        query = translationSortField.ToLowerInvariant() switch
        {
            "id" => sortDescending ? query.OrderByDescending(x => x.Id) : query.OrderBy(x => x.Id),
            "language" => sortDescending
                ? query.OrderByDescending(x => x.LanguageName).ThenByDescending(x => x.LanguageCode)
                : query.OrderBy(x => x.LanguageName).ThenBy(x => x.LanguageCode),
            "name" => sortDescending ? query.OrderByDescending(x => x.LocationName) : query.OrderBy(x => x.LocationName),
            _ => sortDescending ? query.OrderByDescending(x => x.PoiDisplayName) : query.OrderBy(x => x.PoiDisplayName)
        };

        return query.ToList();
    }

    private List<LanguageRow> GetFilteredLanguageItems()
    {
        IEnumerable<LanguageRow> query = languageItems;

        if (!string.IsNullOrWhiteSpace(languageSearchKeyword))
        {
            var keyword = languageSearchKeyword.Trim();
            query = query.Where(x =>
                x.LanguageCode.Contains(keyword, StringComparison.OrdinalIgnoreCase)
                || x.LanguageName.Contains(keyword, StringComparison.OrdinalIgnoreCase));
        }

        var sortDescending = string.Equals(languageSortDirection, "desc", StringComparison.OrdinalIgnoreCase);
        query = languageSortField.ToLowerInvariant() switch
        {
            "id" => sortDescending ? query.OrderByDescending(x => x.Id) : query.OrderBy(x => x.Id),
            "code" => sortDescending ? query.OrderByDescending(x => x.LanguageCode) : query.OrderBy(x => x.LanguageCode),
            _ => sortDescending ? query.OrderByDescending(x => x.LanguageName) : query.OrderBy(x => x.LanguageName)
        };

        return query.ToList();
    }

    private int GetLanguageTotalPages(int totalRows)
    {
        return GetTotalPages(totalRows, languagePageSize);
    }

    private int GetTranslationTotalPages(int totalRows)
    {
        return GetTotalPages(totalRows, translationPageSize);
    }

    private static int GetTotalPages(int totalRows, int pageSize)
    {
        var safePageSize = Math.Max(1, pageSize);
        return Math.Max(1, (int)Math.Ceiling(totalRows / (double)safePageSize));
    }

    private void MoveLanguagePage(int delta)
    {
        var totalPages = GetLanguageTotalPages(GetFilteredLanguageItems().Count);
        languagePageIndex = Math.Clamp(languagePageIndex + delta, 1, totalPages);
    }

    private void MoveTranslationPage(int delta)
    {
        var totalPages = GetTranslationTotalPages(GetFilteredTranslationItems().Count);
        translationPageIndex = Math.Clamp(translationPageIndex + delta, 1, totalPages);
    }

    private void ResetLanguageGrid()
    {
        languageSearchKeyword = string.Empty;
        languageSortField = "name";
        languageSortDirection = "asc";
        languagePageSize = 10;
        languagePageIndex = 1;
    }

