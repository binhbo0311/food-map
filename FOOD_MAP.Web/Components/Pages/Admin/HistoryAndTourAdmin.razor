    private async Task BeginEditTourListAsync(TourListRow row)
    {
        isBusy = true;
        try
        {
            await using var dbContext = await DbContextFactory.CreateDbContextAsync();
            var rows = await BuildTourScopeQuery(dbContext, row.OwnerUserId, row.TourCode)
                .OrderBy(x => x.SortOrder)
                .ToListAsync();

            if (rows.Count == 0)
            {
                isErrorStatus = true;
                statusMessage = $"Tour '{row.TourCode}' không tồn tại hoặc đã bị xóa.";
                return;
            }

            var header = rows[0];
            isTourListEditorOpen = true;
            isTourListEditMode = true;
            isTourListEditorErrorStatus = false;
            tourListEditorStatusMessage = string.Empty;
            editingTourCode = header.TourCode;
            editingOwnerUserId = header.OwnerUserId;
            tourListEditorModel.TourCode = header.TourCode;
            tourListEditorModel.TourName = header.TourName ?? string.Empty;
            tourListEditorModel.OwnerUserId = header.OwnerUserId;
            tourListEditorModel.IsPublic = header.IsPublic;
            SetSelectedPois(rows.Select(x => x.PoiId));
        }
        catch (Exception ex)
        {
            isErrorStatus = true;
            statusMessage = $"Không thể nạp tour để chỉnh sửa: {ex.Message}";
        }
        finally
        {
            isBusy = false;
        }
    }

    private async Task SaveTourListAsync()
    {
        isBusy = true;
        isTourListEditorBusy = true;
        try
        {
            var normalizedCode = NormalizeTourCode(tourListEditorModel.TourCode);
            var normalizedName = string.IsNullOrWhiteSpace(tourListEditorModel.TourName)
                ? string.Empty
                : tourListEditorModel.TourName.Trim();
            var normalizedPoiIds = tourListPoiOptions
                .Where(x => x.IsSelected)
                .Select(x => x.PoiId)
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .ToList();

            if (normalizedPoiIds.Count == 0)
            {
                isTourListEditorErrorStatus = true;
                tourListEditorStatusMessage = "Cần ít nhất 1 POI hợp lệ để lưu tour.";
                return;
            }

            await using var dbContext = await DbContextFactory.CreateDbContextAsync();

            var isCreating = !isTourListEditMode;
            if (isCreating)
            {
                var hasExistingTourCode = await dbContext.TourLists
                    .AsNoTracking()
                    .AnyAsync(x => x.TourCode == normalizedCode);

                if (hasExistingTourCode)
                {
                    isTourListEditorErrorStatus = true;
                    tourListEditorStatusMessage = $"Tour code '{normalizedCode}' đã tồn tại.";
                    return;
                }
            }
            else
            {
                var existingRows = await BuildTourScopeQuery(dbContext, editingOwnerUserId, editingTourCode)
                    .ToListAsync();

                if (existingRows.Count == 0)
                {
                    isTourListEditorErrorStatus = true;
                    tourListEditorStatusMessage = $"Tour '{editingTourCode}' không tồn tại hoặc đã bị xóa.";
                    return;
                }

                dbContext.TourLists.RemoveRange(existingRows);
            }

            var nowUtc = DateTimeOffset.UtcNow;
            var rowsToSave = normalizedPoiIds
                .Select((poiId, index) => new TourList
                {
                    TourCode = normalizedCode,
                    TourName = string.IsNullOrWhiteSpace(normalizedName) ? null : normalizedName,
                    OwnerUserId = tourListEditorModel.OwnerUserId,
                    IsPublic = tourListEditorModel.IsPublic,
                    PoiId = poiId,
                    SortOrder = index,
                    CreatedUtc = nowUtc
                })
                .ToList();

            await dbContext.TourLists.AddRangeAsync(rowsToSave);
            await dbContext.SaveChangesAsync();

            isTourListEditorErrorStatus = false;
            tourListEditorStatusMessage = isCreating
                ? $"Đã tạo tour '{normalizedCode}' với {rowsToSave.Count} POI."
                : $"Đã cập nhật tour '{normalizedCode}' với {rowsToSave.Count} POI.";
            statusMessage = tourListEditorStatusMessage;
            isErrorStatus = false;
            isTourListEditorOpen = false;
            isTourListEditMode = false;
            await LoadDashboardAsync();
        }
        catch (Exception ex)
        {
            isTourListEditorErrorStatus = true;
            tourListEditorStatusMessage = $"Không thể lưu tour: {ex.Message}";
        }
        finally
        {
            isBusy = false;
            isTourListEditorBusy = false;
        }
    }

    private static string NormalizeTourCode(string value)
    {
        var normalized = string.IsNullOrWhiteSpace(value)
            ? string.Empty
            : value.Trim().ToUpperInvariant();

        if (string.IsNullOrWhiteSpace(normalized))
        {
            return string.Empty;
        }

        return new string(normalized.Where(ch => char.IsLetterOrDigit(ch) || ch == '_' || ch == '-').ToArray());
    }

    private void TogglePoiSelection(string poiId, ChangeEventArgs args)
    {
        var item = tourListPoiOptions.FirstOrDefault(x => x.PoiId == poiId);
        if (item is null)
        {
            return;
        }

        item.IsSelected = args.Value switch
        {
            bool b => b,
            string s when bool.TryParse(s, out var parsed) => parsed,
            _ => false
        };
    }

    private void SetSelectedPois(IEnumerable<string> poiIds)
    {
        var selected = poiIds
            .Where(x => !string.IsNullOrWhiteSpace(x))
            .Select(x => x.Trim().ToUpperInvariant())
            .ToHashSet(StringComparer.OrdinalIgnoreCase);

        foreach (var poi in tourListPoiOptions)
        {
            poi.IsSelected = selected.Contains(poi.PoiId);
        }
    }

    private void ClearPoiSelections()
    {
        foreach (var poi in tourListPoiOptions)
        {
            poi.IsSelected = false;
        }
    }

    private static IQueryable<TourList> BuildTourScopeQuery(AppDbContext dbContext, int? ownerUserId, string? tourCode)
    {
        var normalizedTourCode = string.IsNullOrWhiteSpace(tourCode)
            ? string.Empty
            : tourCode.Trim().ToUpperInvariant();

        return dbContext.TourLists.Where(x =>
            x.TourCode == normalizedTourCode
            && ((ownerUserId.HasValue && x.OwnerUserId == ownerUserId)
                || (!ownerUserId.HasValue && x.OwnerUserId == null)));
    }

