@page "/admin/history-tour"
@using FOOD_MAP.Shared.Data
@using FOOD_MAP.Shared.Models
@using Microsoft.EntityFrameworkCore
@using System.ComponentModel.DataAnnotations
@inject IDbContextFactory<AppDbContext> DbContextFactory

<PageTitle>History & Tour Admin</PageTitle>

<CmsRoleGate AllowedRoles="@(new[] { UserRole.Admin })">

<h1>History & Tour Admin</h1>
<p class="text-muted">Monitor user activity, favorites, tour visit history, and manage user TourList.</p>

<div class="d-flex flex-wrap gap-2 mb-3">
    <a class="btn btn-outline-secondary" href="/admin">Open Admin Dashboard</a>
    <a class="btn btn-outline-primary" href="/admin/poi">Open POI Admin</a>
</div>

@if (!string.IsNullOrWhiteSpace(statusMessage))
{
    <div class="alert @(isErrorStatus ? "alert-danger" : "alert-success")" role="alert">
        @statusMessage
    </div>
}

@if (isBusy)
{
    <p>Loading...</p>
}
else
{

<section class="border rounded p-3 bg-white mb-3">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h2 class="h5 mb-0">User Tour Lists</h2>
            <button type="button" class="btn btn-sm btn-primary" @onclick="OpenCreateTourListEditor" disabled="@isBusy">Add Tour</button>
        </div>

        @if (isTourListEditorOpen)
        {
            <div class="border rounded p-3 mb-3 bg-light-subtle">
                <h3 class="h6 mb-3">@(isTourListEditMode ? "Edit Tour" : "Add Tour")</h3>

                @if (!string.IsNullOrWhiteSpace(tourListEditorStatusMessage))
                {
                    <div class="alert @(isTourListEditorErrorStatus ? "alert-danger" : "alert-success") py-2" role="alert">
                        @tourListEditorStatusMessage
                    </div>
                }

                <EditForm Model="tourListEditorModel" OnValidSubmit="SaveTourListAsync">
                    <DataAnnotationsValidator />
                    <ValidationSummary />

                    <div class="row g-3">
                        <div class="col-md-3">
                            <label class="form-label">Tour Code</label>
                            <InputText @bind-Value="tourListEditorModel.TourCode" class="form-control" disabled="@isTourListEditMode" />
                            <ValidationMessage For="@(() => tourListEditorModel.TourCode)" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Owner</label>
                            <InputSelect @bind-Value="tourListEditorModel.OwnerUserId" class="form-select" disabled="@isTourListEditMode">
                                <option value="">System</option>
                                @foreach (var owner in tourListOwnerOptions)
                                {
                                    <option value="@owner.UserId">@owner.DisplayLabel</option>
                                }
                            </InputSelect>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Tour Name</label>
                            <InputText @bind-Value="tourListEditorModel.TourName" class="form-control" />
                            <ValidationMessage For="@(() => tourListEditorModel.TourName)" />
                        </div>
                        <div class="col-md-2 d-flex align-items-end">
                            <div class="form-check">
                                <InputCheckbox @bind-Value="tourListEditorModel.IsPublic" class="form-check-input" />
                                <label class="form-check-label">Public</label>
                            </div>
                        </div>
                        <div class="col-12">
                            <label class="form-label d-flex justify-content-between">
                                <span>POI list (checkbox)</span>
                                <span class="text-muted small">@tourListPoiOptions.Count(x => x.IsSelected) / @tourListPoiOptions.Count selected</span>
                            </label>
                            <div class="border rounded bg-white p-2" style="max-height: 260px; overflow-y: auto;">
                                @if (tourListPoiOptions.Count == 0)
                                {
                                    <div class="text-muted small">No POI available.</div>
                                }
                                else
                                {
                                    @foreach (var poi in tourListPoiOptions)
                                    {
                                        <label class="d-flex align-items-center gap-2 py-1">
                                            <input type="checkbox"
                                                   class="form-check-input"
                                                   checked="@poi.IsSelected"
                                                   @onchange="(e) => TogglePoiSelection(poi.PoiId, e)"
                                                   disabled="@isTourListEditorBusy" />
                                            <span class="small">@poi.DisplayLabel</span>
                                        </label>
                                    }
                                }
                            </div>
                        </div>
                    </div>

                    <div class="d-flex gap-2 mt-3">
                        <button type="submit" class="btn btn-success" disabled="@isTourListEditorBusy">Save</button>
                        <button type="button" class="btn btn-outline-secondary" @onclick="CancelTourListEditor" disabled="@isTourListEditorBusy">Cancel</button>
                    </div>
                </EditForm>
            </div>
        }

        <div class="row g-3 mb-3">
            <div class="col-12 col-md-4">
                <div class="border rounded p-3 bg-light-subtle h-100">
                    <div class="text-muted">Total Tours</div>
                    <div class="fs-4 fw-semibold">@tourListSummary.TotalTours</div>
                </div>
            </div>
            <div class="col-12 col-md-4">
                <div class="border rounded p-3 bg-light-subtle h-100">
                    <div class="text-muted">Total Tour Items</div>
                    <div class="fs-4 fw-semibold">@tourListSummary.TotalTourItems</div>
                </div>
            </div>
            <div class="col-12 col-md-4">
                <div class="border rounded p-3 bg-light-subtle h-100">
                    <div class="text-muted">Users With Tours</div>
                    <div class="fs-4 fw-semibold">@tourListSummary.TotalOwners</div>
                </div>
            </div>
        </div>

        <div class="row g-2 mb-3">
            <div class="col-md-4">
                <label class="form-label">Search</label>
                <InputText @bind-Value="tourListSearchKeyword" class="form-control" placeholder="Display name, username, tour code..." />
            </div>
            <div class="col-md-2">
                <label class="form-label">Visibility</label>
                <InputSelect @bind-Value="tourListVisibilityFilter" class="form-select">
                    <option value="">All</option>
                    <option value="public">Public</option>
                    <option value="private">Private</option>
                </InputSelect>
            </div>
            <div class="col-md-2">
                <label class="form-label">Sort By</label>
                <InputSelect @bind-Value="tourListSortField" class="form-select">
                    <option value="created">Created UTC</option>
                    <option value="owner">Owner</option>
                    <option value="tourcode">Tour Code</option>
                    <option value="items">Items</option>
                </InputSelect>
            </div>
            <div class="col-md-1">
                <label class="form-label">Dir</label>
                <InputSelect @bind-Value="tourListSortDirection" class="form-select">
                    <option value="desc">Desc</option>
                    <option value="asc">Asc</option>
                </InputSelect>
            </div>
            <div class="col-md-1">
                <label class="form-label">Page Size</label>
                <InputSelect @bind-Value="tourListPageSize" class="form-select">
                    @foreach (var size in GridPageSizeOptions)
                    {
                        <option value="@size">@size</option>
                    }
                </InputSelect>
            </div>
            <div class="col-md-2 d-flex align-items-end">
                <button type="button" class="btn btn-outline-secondary w-100" @onclick="ResetTourListGrid">Clear</button>
            </div>
        </div>

        @{
            var filteredTourLists = GetFilteredTourLists();
            var tourListTotalPages = GetTourListTotalPages(filteredTourLists.Count);
            var safeTourListPage = Math.Clamp(tourListPageIndex, 1, tourListTotalPages);
            var pagedTourLists = filteredTourLists
                .Skip((safeTourListPage - 1) * tourListPageSize)
                .Take(tourListPageSize)
                .ToList();
        }

        @if (filteredTourLists.Count == 0)
        {
            <p class="text-muted mb-0">No user tour lists found.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Owner</th>
                            <th>Tour Code</th>
                            <th>Tour Name</th>
                            <th>Items</th>
                            <th>Visibility</th>
                            <th>Created (UTC)</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in pagedTourLists)
                        {
                            <tr>
                                <td>@item.OwnerDisplayName (@item.OwnerUserName)</td>
                                <td>@item.TourCode</td>
                                <td>@item.TourName</td>
                                <td>@item.ItemCount</td>
                                <td>
                                    <span class="badge @(item.IsPublic ? "bg-success" : "bg-secondary")">
                                        @(item.IsPublic ? "Public" : "Private")
                                    </span>
                                </td>
                                <td>@item.CreatedUtc.ToString("yyyy-MM-dd HH:mm:ss")</td>
                                <td class="text-end">
                                    <button type="button"
                                            class="btn btn-sm btn-outline-secondary me-2"
                                            @onclick="() => BeginEditTourListAsync(item)"
                                            disabled="@isBusy">
                                        Edit
                                    </button>
                                    <button type="button"
                                            class="btn btn-sm btn-outline-primary me-2"
                                            @onclick="() => ToggleTourVisibilityAsync(item)"
                                            disabled="@isBusy">
                                        @(item.IsPublic ? "Set Private" : "Set Public")
                                    </button>
                                    <button type="button"
                                            class="btn btn-sm btn-outline-danger"
                                            @onclick="() => DeleteTourListAsync(item)"
                                            disabled="@isBusy">
                                        Delete Tour
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="d-flex justify-content-between align-items-center mt-2">
                <small class="text-muted">Showing @pagedTourLists.Count of @filteredTourLists.Count result(s).</small>
                <div class="btn-group">
                    <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@(safeTourListPage <= 1)" @onclick="() => MoveTourListPage(-1)">Previous</button>
                    <button type="button" class="btn btn-sm btn-outline-secondary" disabled>Page @safeTourListPage / @tourListTotalPages</button>
                    <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@(safeTourListPage >= tourListTotalPages)" @onclick="() => MoveTourListPage(1)">Next</button>
                </div>
            </div>
        }
    </section>

    <section class="border rounded p-3 bg-white mb-3">
        <h2 class="h5 mb-3">Top Users By Tours (@filterModel.Days days)</h2>

        <div class="row g-2 mb-3">
            <div class="col-md-4">
                <label class="form-label">Search</label>
                <InputText @bind-Value="topUserSearchKeyword" class="form-control" placeholder="Display name or username..." />
            </div>
            <div class="col-md-2">
                <label class="form-label">Sort By</label>
                <InputSelect @bind-Value="topUserSortField" class="form-select">
                    <option value="tours">Tours</option>
                    <option value="lastvisit">Last Visit</option>
                    <option value="displayname">Display Name</option>
                    <option value="username">Username</option>
                </InputSelect>
            </div>
            <div class="col-md-2">
                <label class="form-label">Dir</label>
                <InputSelect @bind-Value="topUserSortDirection" class="form-select">
                    <option value="desc">Desc</option>
                    <option value="asc">Asc</option>
                </InputSelect>
            </div>
            <div class="col-md-2">
                <label class="form-label">Page Size</label>
                <InputSelect @bind-Value="topUserPageSize" class="form-select">
                    @foreach (var size in GridPageSizeOptions)
                    {
                        <option value="@size">@size</option>
                    }
                </InputSelect>
            </div>
            <div class="col-md-2 d-flex align-items-end">
                <button type="button" class="btn btn-outline-secondary w-100" @onclick="ResetTopUserGrid">Clear</button>
            </div>
        </div>

        @{
            var filteredTopUsers = GetFilteredTopUsers();
            var topUserTotalPages = GetTopUserTotalPages(filteredTopUsers.Count);
            var safeTopUserPage = Math.Clamp(topUserPageIndex, 1, topUserTotalPages);
            var pagedTopUsers = filteredTopUsers
                .Skip((safeTopUserPage - 1) * topUserPageSize)
                .Take(topUserPageSize)
                .ToList();
        }

        @if (filteredTopUsers.Count == 0)
        {
            <p class="text-muted mb-0">No tour data in selected period.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>User</th>
                            <th>Username</th>
                            <th>Tours</th>
                            <th>Last Visit (UTC)</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in pagedTopUsers)
                        {
                            <tr>
                                <td>@item.DisplayName</td>
                                <td>@item.UserName</td>
                                <td>@item.TourCount</td>
                                <td>@item.LastVisitedUtc.ToString("yyyy-MM-dd HH:mm:ss")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="d-flex justify-content-between align-items-center mt-2">
                <small class="text-muted">Showing @pagedTopUsers.Count of @filteredTopUsers.Count result(s).</small>
                <div class="btn-group">
                    <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@(safeTopUserPage <= 1)" @onclick="() => MoveTopUserPage(-1)">Previous</button>
                    <button type="button" class="btn btn-sm btn-outline-secondary" disabled>Page @safeTopUserPage / @topUserTotalPages</button>
                    <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@(safeTopUserPage >= topUserTotalPages)" @onclick="() => MoveTopUserPage(1)">Next</button>
                </div>
            </div>
        }
    </section>

    <section class="border rounded p-3 bg-white mb-3">
        <h2 class="h5 mb-3">Recent Favorites</h2>

        <div class="row g-2 mb-3">
            <div class="col-md-4">
                <label class="form-label">Search</label>
                <InputText @bind-Value="favoriteSearchKeyword" class="form-control" placeholder="User or POI..." />
            </div>
            <div class="col-md-2">
                <label class="form-label">Sort By</label>
                <InputSelect @bind-Value="favoriteSortField" class="form-select">
                    <option value="created">Created UTC</option>
                    <option value="user">User</option>
                    <option value="poi">POI</option>
                </InputSelect>
            </div>
            <div class="col-md-2">
                <label class="form-label">Dir</label>
                <InputSelect @bind-Value="favoriteSortDirection" class="form-select">
                    <option value="desc">Desc</option>
                    <option value="asc">Asc</option>
                </InputSelect>
            </div>
            <div class="col-md-2">
                <label class="form-label">Page Size</label>
                <InputSelect @bind-Value="favoritePageSize" class="form-select">
                    @foreach (var size in GridPageSizeOptions)
                    {
                        <option value="@size">@size</option>
                    }
                </InputSelect>
            </div>
            <div class="col-md-2 d-flex align-items-end">
                <button type="button" class="btn btn-outline-secondary w-100" @onclick="ResetFavoriteGrid">Clear</button>
            </div>
        </div>

        @{
            var filteredFavorites = GetFilteredFavorites();
            var favoriteTotalPages = GetFavoriteTotalPages(filteredFavorites.Count);
            var safeFavoritePage = Math.Clamp(favoritePageIndex, 1, favoriteTotalPages);
            var pagedFavorites = filteredFavorites
                .Skip((safeFavoritePage - 1) * favoritePageSize)
                .Take(favoritePageSize)
                .ToList();
        }

        @if (filteredFavorites.Count == 0)
        {
            <p class="text-muted mb-0">No favorite data found.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Created (UTC)</th>
                            <th>User</th>
                            <th>POI</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in pagedFavorites)
                        {
                            <tr>
                                <td>@item.CreatedUtc.ToString("yyyy-MM-dd HH:mm:ss")</td>
                                <td>@item.DisplayName (@item.UserName)</td>
                                <td>@item.PoiDisplayName</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="d-flex justify-content-between align-items-center mt-2">
                <small class="text-muted">Showing @pagedFavorites.Count of @filteredFavorites.Count result(s).</small>
                <div class="btn-group">
                    <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@(safeFavoritePage <= 1)" @onclick="() => MoveFavoritePage(-1)">Previous</button>
                    <button type="button" class="btn btn-sm btn-outline-secondary" disabled>Page @safeFavoritePage / @favoriteTotalPages</button>
                    <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@(safeFavoritePage >= favoriteTotalPages)" @onclick="() => MoveFavoritePage(1)">Next</button>
                </div>
            </div>
        }
    </section>

    <section class="border rounded p-3 bg-white">
        <h2 class="h5 mb-3">Recent Tour History</h2>

        <div class="row g-2 mb-3">
            <div class="col-md-3">
                <label class="form-label">Search</label>
                <InputText @bind-Value="tourSearchKeyword" class="form-control" placeholder="User, POI, trigger..." />
            </div>
            <div class="col-md-2">
                <label class="form-label">Language</label>
                <InputText @bind-Value="tourLanguageFilter" class="form-control" placeholder="vi, en..." />
            </div>
            <div class="col-md-2">
                <label class="form-label">Sort By</label>
                <InputSelect @bind-Value="tourSortField" class="form-select">
                    <option value="visited">Visited UTC</option>
                    <option value="user">User</option>
                    <option value="poi">POI</option>
                    <option value="language">Language</option>
                    <option value="trigger">Trigger</option>
                </InputSelect>
            </div>
            <div class="col-md-2">
                <label class="form-label">Dir</label>
                <InputSelect @bind-Value="tourSortDirection" class="form-select">
                    <option value="desc">Desc</option>
                    <option value="asc">Asc</option>
                </InputSelect>
            </div>
            <div class="col-md-1">
                <label class="form-label">Page Size</label>
                <InputSelect @bind-Value="tourPageSize" class="form-select">
                    @foreach (var size in GridPageSizeOptions)
                    {
                        <option value="@size">@size</option>
                    }
                </InputSelect>
            </div>
            <div class="col-md-2 d-flex align-items-end">
                <button type="button" class="btn btn-outline-secondary w-100" @onclick="ResetTourGrid">Clear</button>
            </div>
        </div>

        @{
            var filteredTours = GetFilteredTours();
            var tourTotalPages = GetTourTotalPages(filteredTours.Count);
            var safeTourPage = Math.Clamp(tourPageIndex, 1, tourTotalPages);
            var pagedTours = filteredTours
                .Skip((safeTourPage - 1) * tourPageSize)
                .Take(tourPageSize)
                .ToList();
        }

        @if (filteredTours.Count == 0)
        {
            <p class="text-muted mb-0">No tour history data found.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Visited (UTC)</th>
                            <th>User</th>
                            <th>POI</th>
                            <th>Language</th>
                            <th>Trigger</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in pagedTours)
                        {
                            <tr>
                                <td>@item.VisitedUtc.ToString("yyyy-MM-dd HH:mm:ss")</td>
                                <td>@item.DisplayName (@item.UserName)</td>
                                <td>@item.PoiDisplayName</td>
                                <td>@item.LanguageCode</td>
                                <td>@item.TriggerType</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="d-flex justify-content-between align-items-center mt-2">
                <small class="text-muted">Showing @pagedTours.Count of @filteredTours.Count result(s).</small>
                <div class="btn-group">
                    <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@(safeTourPage <= 1)" @onclick="() => MoveTourPage(-1)">Previous</button>
                    <button type="button" class="btn btn-sm btn-outline-secondary" disabled>Page @safeTourPage / @tourTotalPages</button>
                    <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@(safeTourPage >= tourTotalPages)" @onclick="() => MoveTourPage(1)">Next</button>
                </div>
            </div>
        }
    </section>
}

</CmsRoleGate>

@code {
    private readonly DashboardFilterModel filterModel = new();

    private DashboardSummary summary = new();
    private TourListSummary tourListSummary = new();
    private readonly List<TopUserRow> topUsersByTours = [];
    private readonly List<FavoriteRow> recentFavorites = [];
    private readonly List<TourRow> recentTours = [];
    private readonly List<TourListRow> userTourLists = [];

    private bool isBusy;
    private bool isErrorStatus;
    private string statusMessage = string.Empty;

    private string topUserSearchKeyword = string.Empty;
    private string topUserSortField = "tours";
    private string topUserSortDirection = "desc";
    private int topUserPageSize = 10;
    private int topUserPageIndex = 1;

    private string favoriteSearchKeyword = string.Empty;
    private string favoriteSortField = "created";
    private string favoriteSortDirection = "desc";
    private int favoritePageSize = 10;
    private int favoritePageIndex = 1;

    private string tourSearchKeyword = string.Empty;
    private string tourLanguageFilter = string.Empty;
    private string tourSortField = "visited";
    private string tourSortDirection = "desc";
    private int tourPageSize = 10;
    private int tourPageIndex = 1;

    private string tourListSearchKeyword = string.Empty;
    private string tourListVisibilityFilter = string.Empty;
    private string tourListSortField = "created";
    private string tourListSortDirection = "desc";
    private int tourListPageSize = 10;
    private int tourListPageIndex = 1;
    private bool isTourListEditorOpen;
    private bool isTourListEditMode;
    private bool isTourListEditorBusy;
    private bool isTourListEditorErrorStatus;
    private string tourListEditorStatusMessage = string.Empty;
    private string editingTourCode = string.Empty;
    private int? editingOwnerUserId;
    private readonly TourListEditorModel tourListEditorModel = new();
    private readonly List<UserOption> tourListOwnerOptions = [];
    private readonly List<PoiOption> tourListPoiOptions = [];

    private static readonly int[] GridPageSizeOptions = [5, 10, 20, 50];

    protected override async Task OnInitializedAsync()
    {
        await LoadDashboardAsync();
    }

    private async Task ApplyFilterAsync()
    {
        await LoadDashboardAsync();
    }

    private async Task ResetFilterAsync()
    {
        filterModel.Days = 30;
        filterModel.RecentLimit = 20;
        await LoadDashboardAsync();
    }

    private async Task LoadDashboardAsync()
    {
        isBusy = true;
        statusMessage = string.Empty;

        try
        {
            var windowStart = DateTimeOffset.UtcNow.AddDays(-filterModel.Days);
            var windowEnd = DateTimeOffset.UtcNow;

            await using var dbContext = await DbContextFactory.CreateDbContextAsync();

            var poiRawData = await dbContext.Pois
                .AsNoTracking()
                .Select(p => new
                {
                    p.Id,
                    ViName = p.PoiTranslations
                        .Where(t => t.Language != null && t.Language.LanguageCode == "vi")
                        .Select(t => t.LocationName)
                        .FirstOrDefault(),
                    FirstName = p.PoiTranslations
                        .OrderBy(t => t.LanguageId)
                        .Select(t => t.LocationName)
                        .FirstOrDefault()
                })
                .ToListAsync();

            var poiOptions = poiRawData
                .Select(p => new
                {
                    p.Id,
                    Name = p.ViName ?? p.FirstName ?? $"POI #{p.Id}"
                })
                .OrderBy(x => x.Name)
                .ThenBy(x => x.Id)
                .ToList();

            var poiNameLookup = poiOptions.ToDictionary(x => x.Id, x => x.Name);

            summary = new DashboardSummary
            {
                TotalUsers = await dbContext.Users.AsNoTracking().CountAsync(),
                TotalFavorites = await dbContext.UserFavorites.AsNoTracking().CountAsync(),
                TotalTours = await dbContext.UserTours.AsNoTracking().CountAsync(),
                ActiveUsersInWindow = await dbContext.UserTours
                    .AsNoTracking()
                    .Where(x => x.VisitedUtc >= windowStart && x.VisitedUtc <= windowEnd)
                    .Select(x => x.UserId)
                    .Distinct()
                    .CountAsync(),
                FavoritesInWindow = await dbContext.UserFavorites
                    .AsNoTracking()
                    .CountAsync(x => x.CreatedUtc >= windowStart && x.CreatedUtc <= windowEnd),
                ToursInWindow = await dbContext.UserTours
                    .AsNoTracking()
                    .CountAsync(x => x.VisitedUtc >= windowStart && x.VisitedUtc <= windowEnd)
            };

            var topUsers = await (
                from tour in dbContext.UserTours.AsNoTracking()
                join user in dbContext.Users.AsNoTracking() on tour.UserId equals user.Id
                where tour.VisitedUtc >= windowStart && tour.VisitedUtc <= windowEnd
                group new { tour, user } by new { user.Id, user.UserName, user.DisplayName }
                into g
                orderby g.Count() descending, g.Key.Id
                select new TopUserRow
                {
                    UserId = g.Key.Id,
                    UserName = g.Key.UserName,
                    DisplayName = g.Key.DisplayName,
                    TourCount = g.Count(),
                    LastVisitedUtc = g.Max(x => x.tour.VisitedUtc)
                })
                .ToListAsync();

            var ownerOptions = await dbContext.Users
                .AsNoTracking()
                .OrderBy(x => x.DisplayName)
                .ThenBy(x => x.UserName)
                .Select(x => new UserOption
                {
                    UserId = x.Id,
                    DisplayName = x.DisplayName,
                    UserName = x.UserName
                })
                .ToListAsync();

            var tourListRows = await (
                from tourItem in dbContext.TourLists.AsNoTracking()
                join user in dbContext.Users.AsNoTracking() on tourItem.OwnerUserId equals user.Id into userGroup
                from user in userGroup.DefaultIfEmpty()
                group new { tourItem, user } by new
                {
                    OwnerUserId = tourItem.OwnerUserId,
                    UserName = user != null ? user.UserName : "System",
                    DisplayName = user != null ? user.DisplayName : "System",
                    tourItem.TourCode,
                    tourItem.TourName,
                    tourItem.IsPublic
                }
                into g
                orderby g.Max(x => x.tourItem.CreatedUtc) descending
                select new TourListRow
                {
                    OwnerUserId = g.Key.OwnerUserId,
                    OwnerUserName = g.Key.UserName,
                    OwnerDisplayName = g.Key.DisplayName,
                    TourCode = g.Key.TourCode,
                    TourName = g.Key.TourName ?? string.Empty,
                    IsPublic = g.Key.IsPublic,
                    ItemCount = g.Count(),
                    CreatedUtc = g.Min(x => x.tourItem.CreatedUtc)
                })
                .ToListAsync();

            var favoriteRows = await (
                from favorite in dbContext.UserFavorites.AsNoTracking()
                join user in dbContext.Users.AsNoTracking() on favorite.UserId equals user.Id
                where favorite.CreatedUtc >= windowStart && favorite.CreatedUtc <= windowEnd
                orderby favorite.CreatedUtc descending
                select new FavoriteRow
                {
                    UserId = favorite.UserId,
                    UserName = user.UserName,
                    DisplayName = user.DisplayName,
                    PoiId = favorite.PoiId,
                    CreatedUtc = favorite.CreatedUtc
                })
                .Take(filterModel.RecentLimit)
                .ToListAsync();

            foreach (var row in favoriteRows)
            {
                row.PoiDisplayName = poiNameLookup.TryGetValue(row.PoiId, out var poiName)
                    ? poiName
                    : $"POI #{row.PoiId}";
            }

            var tourRows = await (
                from tour in dbContext.UserTours.AsNoTracking()
                join user in dbContext.Users.AsNoTracking() on tour.UserId equals user.Id
                where tour.VisitedUtc >= windowStart && tour.VisitedUtc <= windowEnd
                orderby tour.VisitedUtc descending
                select new TourRow
                {
                    UserId = tour.UserId,
                    UserName = user.UserName,
                    DisplayName = user.DisplayName,
                    PoiId = tour.PoiId,
                    LanguageCode = tour.LanguageCode,
                    TriggerType = tour.TriggerType,
                    VisitedUtc = tour.VisitedUtc
                })
                .Take(filterModel.RecentLimit)
                .ToListAsync();

            foreach (var row in tourRows)
            {
                row.PoiDisplayName = poiNameLookup.TryGetValue(row.PoiId, out var poiName)
                    ? poiName
                    : $"POI #{row.PoiId}";
            }

            topUsersByTours.Clear();
            topUsersByTours.AddRange(topUsers);

            recentFavorites.Clear();
            recentFavorites.AddRange(favoriteRows);

            recentTours.Clear();
            recentTours.AddRange(tourRows);

            userTourLists.Clear();
            userTourLists.AddRange(tourListRows);

            tourListOwnerOptions.Clear();
            tourListOwnerOptions.AddRange(ownerOptions);

            var selectedPoiIds = tourListPoiOptions.Where(x => x.IsSelected).Select(x => x.PoiId).ToHashSet(StringComparer.OrdinalIgnoreCase);
            tourListPoiOptions.Clear();
            tourListPoiOptions.AddRange(poiOptions.Select(x => new PoiOption
            {
                PoiId = x.Id,
                PoiName = x.Name,
                IsSelected = selectedPoiIds.Contains(x.Id)
            }));

            tourListSummary = new TourListSummary
            {
                TotalTours = tourListRows.Count,
                TotalTourItems = tourListRows.Sum(x => x.ItemCount),
                TotalOwners = tourListRows.Select(x => x.OwnerUserId).Distinct().Count()
            };

            topUserPageIndex = 1;
            favoritePageIndex = 1;
            tourPageIndex = 1;
            tourListPageIndex = 1;

            isErrorStatus = false;
            statusMessage = $"Loaded dashboard for last {filterModel.Days} days.";
        }
        catch (Exception ex)
        {
            isErrorStatus = true;
            statusMessage = $"Unable to load dashboard: {ex.Message}";
        }
        finally
        {
            isBusy = false;
        }
    }

    private List<TopUserRow> GetFilteredTopUsers()
    {
        IEnumerable<TopUserRow> query = topUsersByTours;

        if (!string.IsNullOrWhiteSpace(topUserSearchKeyword))
        {
            var keyword = topUserSearchKeyword.Trim();
            query = query.Where(x =>
                x.DisplayName.Contains(keyword, StringComparison.OrdinalIgnoreCase)
                || x.UserName.Contains(keyword, StringComparison.OrdinalIgnoreCase));
        }

        var sortDescending = string.Equals(topUserSortDirection, "desc", StringComparison.OrdinalIgnoreCase);
        query = topUserSortField.ToLowerInvariant() switch
        {
            "displayname" => sortDescending ? query.OrderByDescending(x => x.DisplayName) : query.OrderBy(x => x.DisplayName),
            "username" => sortDescending ? query.OrderByDescending(x => x.UserName) : query.OrderBy(x => x.UserName),
            "lastvisit" => sortDescending ? query.OrderByDescending(x => x.LastVisitedUtc) : query.OrderBy(x => x.LastVisitedUtc),
            _ => sortDescending ? query.OrderByDescending(x => x.TourCount) : query.OrderBy(x => x.TourCount)
        };

        return query.ToList();
    }

    private List<FavoriteRow> GetFilteredFavorites()
    {
        IEnumerable<FavoriteRow> query = recentFavorites;

        if (!string.IsNullOrWhiteSpace(favoriteSearchKeyword))
        {
            var keyword = favoriteSearchKeyword.Trim();
            query = query.Where(x =>
                x.DisplayName.Contains(keyword, StringComparison.OrdinalIgnoreCase)
                || x.UserName.Contains(keyword, StringComparison.OrdinalIgnoreCase)
                || x.PoiDisplayName.Contains(keyword, StringComparison.OrdinalIgnoreCase)
                || x.PoiId.Contains(keyword, StringComparison.OrdinalIgnoreCase));
        }

        var sortDescending = string.Equals(favoriteSortDirection, "desc", StringComparison.OrdinalIgnoreCase);
        query = favoriteSortField.ToLowerInvariant() switch
        {
            "user" => sortDescending
                ? query.OrderByDescending(x => x.DisplayName).ThenByDescending(x => x.UserName)
                : query.OrderBy(x => x.DisplayName).ThenBy(x => x.UserName),
            "poi" => sortDescending ? query.OrderByDescending(x => x.PoiDisplayName) : query.OrderBy(x => x.PoiDisplayName),
            _ => sortDescending ? query.OrderByDescending(x => x.CreatedUtc) : query.OrderBy(x => x.CreatedUtc)
        };

        return query.ToList();
    }

    private List<TourRow> GetFilteredTours()
    {
        IEnumerable<TourRow> query = recentTours;

        if (!string.IsNullOrWhiteSpace(tourSearchKeyword))
        {
            var keyword = tourSearchKeyword.Trim();
            query = query.Where(x =>
                x.DisplayName.Contains(keyword, StringComparison.OrdinalIgnoreCase)
                || x.UserName.Contains(keyword, StringComparison.OrdinalIgnoreCase)
                || x.PoiDisplayName.Contains(keyword, StringComparison.OrdinalIgnoreCase)
                || x.PoiId.Contains(keyword, StringComparison.OrdinalIgnoreCase)
                || x.TriggerType.Contains(keyword, StringComparison.OrdinalIgnoreCase));
        }

        if (!string.IsNullOrWhiteSpace(tourLanguageFilter))
        {
            var language = tourLanguageFilter.Trim();
            query = query.Where(x => x.LanguageCode.Contains(language, StringComparison.OrdinalIgnoreCase));
        }

        var sortDescending = string.Equals(tourSortDirection, "desc", StringComparison.OrdinalIgnoreCase);
        query = tourSortField.ToLowerInvariant() switch
        {
            "user" => sortDescending
                ? query.OrderByDescending(x => x.DisplayName).ThenByDescending(x => x.UserName)
                : query.OrderBy(x => x.DisplayName).ThenBy(x => x.UserName),
            "poi" => sortDescending ? query.OrderByDescending(x => x.PoiDisplayName) : query.OrderBy(x => x.PoiDisplayName),
            "language" => sortDescending ? query.OrderByDescending(x => x.LanguageCode) : query.OrderBy(x => x.LanguageCode),
            "trigger" => sortDescending ? query.OrderByDescending(x => x.TriggerType) : query.OrderBy(x => x.TriggerType),
            _ => sortDescending ? query.OrderByDescending(x => x.VisitedUtc) : query.OrderBy(x => x.VisitedUtc)
        };

        return query.ToList();
    }

    private List<TourListRow> GetFilteredTourLists()
    {
        IEnumerable<TourListRow> query = userTourLists;

        if (!string.IsNullOrWhiteSpace(tourListSearchKeyword))
        {
            var keyword = tourListSearchKeyword.Trim();
            query = query.Where(x =>
                x.OwnerDisplayName.Contains(keyword, StringComparison.OrdinalIgnoreCase)
                || x.OwnerUserName.Contains(keyword, StringComparison.OrdinalIgnoreCase)
                || x.TourCode.Contains(keyword, StringComparison.OrdinalIgnoreCase)
                || x.TourName.Contains(keyword, StringComparison.OrdinalIgnoreCase));
        }

        if (!string.IsNullOrWhiteSpace(tourListVisibilityFilter))
        {
            var isPublic = string.Equals(tourListVisibilityFilter, "public", StringComparison.OrdinalIgnoreCase);
            query = query.Where(x => x.IsPublic == isPublic);
        }

        var sortDescending = string.Equals(tourListSortDirection, "desc", StringComparison.OrdinalIgnoreCase);
        query = tourListSortField.ToLowerInvariant() switch
        {
            "owner" => sortDescending
                ? query.OrderByDescending(x => x.OwnerDisplayName).ThenByDescending(x => x.OwnerUserName)
                : query.OrderBy(x => x.OwnerDisplayName).ThenBy(x => x.OwnerUserName),
            "tourcode" => sortDescending ? query.OrderByDescending(x => x.TourCode) : query.OrderBy(x => x.TourCode),
            "items" => sortDescending ? query.OrderByDescending(x => x.ItemCount) : query.OrderBy(x => x.ItemCount),
            _ => sortDescending ? query.OrderByDescending(x => x.CreatedUtc) : query.OrderBy(x => x.CreatedUtc)
        };

        return query.ToList();
    }

    private int GetTopUserTotalPages(int totalRows)
    {
        return GetTotalPages(totalRows, topUserPageSize);
    }

    private int GetFavoriteTotalPages(int totalRows)
    {
        return GetTotalPages(totalRows, favoritePageSize);
    }

    private int GetTourTotalPages(int totalRows)
    {
        return GetTotalPages(totalRows, tourPageSize);
    }

    private int GetTourListTotalPages(int totalRows)
    {
        return GetTotalPages(totalRows, tourListPageSize);
    }

    private static int GetTotalPages(int totalRows, int pageSize)
    {
        var safePageSize = Math.Max(1, pageSize);
        return Math.Max(1, (int)Math.Ceiling(totalRows / (double)safePageSize));
    }

    private void MoveTopUserPage(int delta)
    {
        var totalPages = GetTopUserTotalPages(GetFilteredTopUsers().Count);
        topUserPageIndex = Math.Clamp(topUserPageIndex + delta, 1, totalPages);
    }

    private void MoveFavoritePage(int delta)
    {
        var totalPages = GetFavoriteTotalPages(GetFilteredFavorites().Count);
        favoritePageIndex = Math.Clamp(favoritePageIndex + delta, 1, totalPages);
    }

    private void MoveTourPage(int delta)
    {
        var totalPages = GetTourTotalPages(GetFilteredTours().Count);
        tourPageIndex = Math.Clamp(tourPageIndex + delta, 1, totalPages);
    }

    private void MoveTourListPage(int delta)
    {
        var totalPages = GetTourListTotalPages(GetFilteredTourLists().Count);
        tourListPageIndex = Math.Clamp(tourListPageIndex + delta, 1, totalPages);
    }

