    private async Task ToggleTourVisibilityAsync(TourListRow row)
    {
        isBusy = true;
        try
        {
            await using var dbContext = await DbContextFactory.CreateDbContextAsync();
            var items = await BuildTourScopeQuery(dbContext, row.OwnerUserId, row.TourCode)
                .ToListAsync();

            if (items.Count == 0)
            {
                isErrorStatus = true;
                statusMessage = $"Tour '{row.TourCode}' không tồn tại hoặc đã bị xóa.";
                return;
            }

            var newValue = !row.IsPublic;
            foreach (var item in items)
            {
                item.IsPublic = newValue;
            }

            await dbContext.SaveChangesAsync();

            isErrorStatus = false;
            statusMessage = $"Đã cập nhật visibility cho tour '{row.TourCode}' thành {(newValue ? "Public" : "Private")}.";
            await LoadDashboardAsync();
        }
        catch (Exception ex)
        {
            isErrorStatus = true;
            statusMessage = $"Không thể cập nhật visibility tour: {ex.Message}";
        }
        finally
        {
            isBusy = false;
        }
    }

    private async Task DeleteTourListAsync(TourListRow row)
    {
        isBusy = true;
        try
        {
            await using var dbContext = await DbContextFactory.CreateDbContextAsync();
            var items = await BuildTourScopeQuery(dbContext, row.OwnerUserId, row.TourCode)
                .ToListAsync();

            if (items.Count == 0)
            {
                isErrorStatus = true;
                statusMessage = $"Tour '{row.TourCode}' không tồn tại hoặc đã bị xóa.";
                return;
            }

            dbContext.TourLists.RemoveRange(items);
            await dbContext.SaveChangesAsync();

            isErrorStatus = false;
            statusMessage = $"Đã xóa tour '{row.TourCode}' của user '{row.OwnerUserName}'.";
            await LoadDashboardAsync();
        }
        catch (Exception ex)
        {
            isErrorStatus = true;
            statusMessage = $"Không thể xóa tour: {ex.Message}";
        }
        finally
        {
            isBusy = false;
        }
    }

