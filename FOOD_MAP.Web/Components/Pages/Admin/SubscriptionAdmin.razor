@page "/admin/subscriptions"
@using FOOD_MAP.Shared.Data
@using FOOD_MAP.Shared.Models
@using FOOD_MAP.Shared.Services
@using Microsoft.EntityFrameworkCore
@using System.ComponentModel.DataAnnotations
@inject IDbContextFactory<AppDbContext> DbContextFactory
@inject ISubscriptionService SubscriptionService
@inject ISubscriptionPlanService SubscriptionPlanService
@inject PortalUserSessionState PortalUserSessionState

<PageTitle>Subscription & Payment Admin</PageTitle>

<CmsRoleGate AllowedRoles="@(new[] { UserRole.Admin, UserRole.Owner })" OnAccessGranted="HandleAccessGrantedAsync">

<h1>Subscription & Payment Admin</h1>
<p class="text-muted">Upgrade owner and user accounts to unlock POI and activation radius limits.</p>

<div class="d-flex flex-wrap gap-2 mb-3">
    <a class="btn btn-outline-secondary" href="/admin">Open Admin Dashboard</a>
    <a class="btn btn-outline-primary" href="/admin/history-tour">Open History & Tour</a>
</div>

@if (!string.IsNullOrWhiteSpace(statusMessage))
{
    <div class="alert @(isErrorStatus ? "alert-danger" : "alert-success")" role="alert">
        @statusMessage
    </div>
}

<EditForm Model="paymentModel" OnValidSubmit="ProcessPaymentAsync" class="border rounded p-3 mb-3 bg-light-subtle">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="row g-3">
        <div class="col-md-4">
            <label class="form-label">Account</label>
            <InputSelect @bind-Value="paymentModel.UserId" @bind-Value:after="OnSelectedUserChangedAsync" class="form-select" disabled="@(isBusy || IsOwnerScope)">
                <option value="0">Select account...</option>
                @foreach (var user in userOptions)
                {
                    <option value="@user.UserId">@user.DisplayLabel</option>
                }
            </InputSelect>
        </div>

        <div class="col-md-4">
            <label class="form-label">Subscription Plan</label>
            <InputSelect @bind-Value="paymentModel.SubscriptionPlanId" @bind-Value:after="OnSelectedPlanChangedAsync" class="form-select" disabled="@(isBusy || visiblePlans.Count == 0)">
                <option value="0">Select plan...</option>
                @foreach (var plan in visiblePlans)
                {
                    <option value="@plan.Id">@BuildPlanDisplayLabel(plan)</option>
                }
            </InputSelect>
        </div>

        <div class="col-md-2">
            <label class="form-label">Tier</label>
            <InputSelect @bind-Value="paymentModel.Tier" class="form-select" disabled="true">
                <option value="@SubscriptionTier.Basic">Basic</option>
                <option value="@SubscriptionTier.Premium">Premium</option>
            </InputSelect>
        </div>

        <div class="col-md-2">
            <label class="form-label">Billing Period</label>
            <InputSelect @bind-Value="paymentModel.BillingPeriod" class="form-select" disabled="true">
                <option value="@BillingPeriod.Monthly">Monthly</option>
                <option value="@BillingPeriod.Quarterly">Quarterly</option>
                <option value="@BillingPeriod.Yearly">Yearly</option>
            </InputSelect>
        </div>

        <div class="col-md-2">
            <label class="form-label">Amount</label>
            <InputNumber @bind-Value="paymentModel.Amount" class="form-control" disabled="true" />
        </div>

        <div class="col-md-2">
            <label class="form-label">Currency</label>
            <InputText @bind-Value="paymentModel.Currency" class="form-control" disabled="true" />
        </div>

        <div class="col-md-6">
            <label class="form-label">Payment Provider</label>
            <InputSelect @bind-Value="paymentModel.PaymentProvider" class="form-select" disabled="@isBusy">
                <option value="VnPay">VnPay</option>
                <option value="Momo">Momo</option>
                <option value="Stripe">Stripe</option>
                <option value="Paypal">Paypal</option>
                <option value="ZaloPay">ZaloPay</option>
                @if (!IsOwnerScope)
                {
                    <option value="Manual">Manual</option>
                }
            </InputSelect>
        </div>

        <div class="col-md-6">
            <label class="form-label">Provider Reference Code</label>
            <InputText @bind-Value="paymentModel.PaymentTransactionCode" class="form-control" disabled="@isBusy" placeholder="Code returned by payment provider" />
        </div>
    </div>

    <div class="d-flex gap-2 mt-3">
        <button type="submit" class="btn btn-primary" disabled="@isBusy">Process Online Checkout</button>
        <button type="button" class="btn btn-outline-secondary" @onclick="ResetForm" disabled="@isBusy">Reset</button>
    </div>
</EditForm>

@if (paymentModel.UserId > 0)
{
    <section class="border rounded p-3 bg-white mb-3">
        <h2 class="h5 mb-3">Current Subscription</h2>

        @if (currentPolicy is null)
        {
            <p class="text-muted mb-0">No subscription policy available.</p>
        }
        else
        {
            <div class="row g-3">
                <div class="col-12 col-md-3">
                    <div class="border rounded p-3 h-100">
                        <div class="text-muted">Current Tier</div>
                        <div class="fs-5 fw-semibold">@currentPolicy.Tier</div>
                    </div>
                </div>
                <div class="col-12 col-md-3">
                    <div class="border rounded p-3 h-100">
                        <div class="text-muted">POI Visible Limit</div>
                        <div class="fs-5 fw-semibold">@(currentPolicy.MaxAccessiblePoiCount?.ToString() ?? "Unlimited")</div>
                    </div>
                </div>
                <div class="col-12 col-md-3">
                    <div class="border rounded p-3 h-100">
                        <div class="text-muted">Owner POI Limit</div>
                        <div class="fs-5 fw-semibold">@(currentPolicy.MaxOwnerPoiCount?.ToString() ?? "Unlimited")</div>
                    </div>
                </div>
                <div class="col-12 col-md-3">
                    <div class="border rounded p-3 h-100">
                        <div class="text-muted">Activation Radius Limit</div>
                        <div class="fs-5 fw-semibold">@currentPolicy.MaxActivationRadiusMeters m</div>
                    </div>
                </div>
            </div>

            @if (currentSubscription is not null)
            {
                <div class="mt-3 text-muted small">
                    Active until @currentSubscription.ExpiresUtc.ToString("yyyy-MM-dd HH:mm:ss") UTC
                </div>
            }
        }
    </section>

    <section class="border rounded p-3 bg-white">
        <h2 class="h5 mb-3">Payment History</h2>

        @if (userSubscriptions.Count == 0)
        {
            <p class="text-muted mb-0">No payment records found for this account.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Created (UTC)</th>
                            <th>Tier</th>
                            <th>Billing</th>
                            <th>Status</th>
                            <th>Amount</th>
                            <th>Provider</th>
                            <th>Transaction</th>
                            <th>Expires (UTC)</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in userSubscriptions)
                        {
                            <tr>
                                <td>@item.CreatedUtc.ToString("yyyy-MM-dd HH:mm:ss")</td>
                                <td>@item.Tier</td>
                                <td>@item.BillingPeriod</td>
                                <td>@item.PaymentStatus</td>
                                <td>@item.Amount.ToString("0.##") @item.Currency</td>
                                <td>@item.PaymentProvider</td>
                                <td>@item.PaymentTransactionCode</td>
                                <td>@item.ExpiresUtc.ToString("yyyy-MM-dd HH:mm:ss")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
}

</CmsRoleGate>

@code {
    private readonly List<UserOption> userOptions = [];
    private readonly List<SubscriptionPlan> visiblePlans = [];
    private readonly List<Subscription> userSubscriptions = [];
    private readonly PaymentFormModel paymentModel = new();

    private bool isBusy;
    private bool isErrorStatus;
    private bool hasLoadedData;
    private string statusMessage = string.Empty;
    private Subscription? currentSubscription;
    private SubscriptionFeaturePolicy? currentPolicy;

    private async Task HandleAccessGrantedAsync()
    {
        if (hasLoadedData)
        {
            return;
        }

        hasLoadedData = true;
        await LoadUsersAsync();
    }

    private async Task LoadUsersAsync()
    {
        isBusy = true;
        statusMessage = string.Empty;

        try
        {
            await using var dbContext = await DbContextFactory.CreateDbContextAsync();

            var usersQuery = dbContext.Users
                .AsNoTracking()
                .Where(x => !IsOwnerScope || x.Id == CurrentUserId)
                .OrderBy(x => x.Role)
                .ThenBy(x => x.DisplayName)
                .ThenBy(x => x.UserName)
                .Select(x => new UserOption(
                    x.Id,
                    x.DisplayName,
                    x.UserName,
                    x.Role));

            var users = await usersQuery.ToListAsync();

            userOptions.Clear();
            userOptions.AddRange(users);

            await LoadVisiblePlansAsync();

            var firstOwnerOrUser = users.FirstOrDefault();

            if (firstOwnerOrUser is not null)
            {
                paymentModel.UserId = firstOwnerOrUser.UserId;
                await RefreshSelectedUserDataAsync();
            }
        }
        catch (Exception ex)
        {
            isErrorStatus = true;
            statusMessage = $"Unable to load accounts: {ex.Message}";
        }
        finally
        {
            isBusy = false;
        }
    }

    private async Task LoadVisiblePlansAsync()
    {
        visiblePlans.Clear();

        if (!CurrentUserId.HasValue)
        {
            return;
        }

        var plans = await SubscriptionPlanService.GetVisiblePlansAsync(CurrentUserId.Value);
        var activePaidPlans = plans
            .Where(x => x.IsActive && x.Tier != SubscriptionTier.Free)
            .OrderBy(x => x.Tier)
            .ThenBy(x => x.BillingPeriod)
            .ThenBy(x => x.FixedPrice)
            .ToList();

        visiblePlans.AddRange(activePaidPlans);

        if (visiblePlans.Count > 0)
        {
            paymentModel.SubscriptionPlanId = visiblePlans[0].Id;
            ApplySelectedPlanValues();
        }
    }

    private Task OnSelectedUserChangedAsync()
    {
        return RefreshSelectedUserDataAsync();
    }

    private Task OnSelectedPlanChangedAsync()
    {
        ApplySelectedPlanValues();
        return Task.CompletedTask;
    }

    private void ApplySelectedPlanValues()
    {
        var selectedPlan = visiblePlans.FirstOrDefault(x => x.Id == paymentModel.SubscriptionPlanId);
        if (selectedPlan is null)
        {
            return;
        }

        paymentModel.Tier = selectedPlan.Tier;
        paymentModel.BillingPeriod = selectedPlan.BillingPeriod;
        paymentModel.Amount = selectedPlan.FixedPrice;
        paymentModel.Currency = selectedPlan.Currency;
    }

    private async Task RefreshSelectedUserDataAsync()
    {
        if (paymentModel.UserId <= 0)
        {
            currentSubscription = null;
            currentPolicy = null;
            userSubscriptions.Clear();
            return;
        }

        currentSubscription = await SubscriptionService.GetCurrentSubscriptionAsync(paymentModel.UserId);
        currentPolicy = await SubscriptionService.GetCurrentPolicyAsync(paymentModel.UserId);

        var history = await SubscriptionService.GetUserSubscriptionsAsync(paymentModel.UserId);
        userSubscriptions.Clear();
        userSubscriptions.AddRange(history);

        StateHasChanged();
    }

    private async Task ProcessPaymentAsync()
    {
        if (paymentModel.UserId <= 0)
        {
            isErrorStatus = true;
            statusMessage = "Please select an account.";
            return;
        }

        var selectedPlan = visiblePlans.FirstOrDefault(x => x.Id == paymentModel.SubscriptionPlanId);
        if (selectedPlan is null)
        {
            isErrorStatus = true;
            statusMessage = "Please select a valid subscription plan.";
            return;
        }

        paymentModel.Tier = selectedPlan.Tier;
        paymentModel.BillingPeriod = selectedPlan.BillingPeriod;
        paymentModel.Amount = selectedPlan.FixedPrice;
        paymentModel.Currency = selectedPlan.Currency;

        if (IsOwnerScope && paymentModel.UserId != CurrentUserId)
        {
            isErrorStatus = true;
            statusMessage = "Owners can only update their own subscription.";
            return;
        }

        if (IsOwnerScope && string.Equals(paymentModel.PaymentProvider, "Manual", StringComparison.OrdinalIgnoreCase))
        {
            isErrorStatus = true;
            statusMessage = "Owners must use an online payment provider.";
            return;
        }

        if (string.IsNullOrWhiteSpace(paymentModel.PaymentTransactionCode))
        {
            paymentModel.PaymentTransactionCode = BuildProviderReferenceCode();
        }

        isBusy = true;
        statusMessage = string.Empty;

        try
        {
            var createdSubscription = await SubscriptionService.ProcessPaymentAsync(
                paymentModel.UserId,
                paymentModel.Tier,
                paymentModel.BillingPeriod,
                paymentModel.Amount,
                paymentModel.Currency,
                paymentModel.PaymentProvider,
                paymentModel.PaymentTransactionCode);

            isErrorStatus = false;
            statusMessage = $"Payment success. Account upgraded to {createdSubscription.Tier} until {createdSubscription.ExpiresUtc:yyyy-MM-dd}.";
            await RefreshSelectedUserDataAsync();
            paymentModel.PaymentTransactionCode = string.Empty;
        }
        catch (Exception ex)
        {
            isErrorStatus = true;
            statusMessage = $"Payment failed: {ex.Message}";
        }
        finally
        {
            isBusy = false;
        }
    }

    private bool IsOwnerScope => PortalUserSessionState.IsOwner;

    private int? CurrentUserId => PortalUserSessionState.UserId;

    private void ResetForm()
    {
        if (visiblePlans.Count > 0)
        {
            paymentModel.SubscriptionPlanId = visiblePlans[0].Id;
            ApplySelectedPlanValues();
        }

        paymentModel.PaymentProvider = IsOwnerScope ? "VnPay" : "Manual";
        paymentModel.PaymentTransactionCode = string.Empty;
    }

    private static string BuildPlanDisplayLabel(SubscriptionPlan plan)
    {
        return $"{plan.DisplayName} | {plan.Tier} | {plan.BillingPeriod} | {plan.FixedPrice:0.##} {plan.Currency}";
    }

    private static string BuildProviderReferenceCode()
    {
        var randomPart = Random.Shared.Next(100000, 999999);
        return $"PROV-{DateTimeOffset.UtcNow:yyyyMMddHHmmssfff}-{randomPart}";
    }

    private sealed record UserOption(int UserId, string DisplayName, string UserName, UserRole Role)
    {
        public string DisplayLabel => $"{DisplayName} (@{UserName}) [{Role}]";
    }

    private sealed class PaymentFormModel
    {
        [Range(1, int.MaxValue, ErrorMessage = "Please select an account.")]
        public int UserId { get; set; }

        [Range(1, int.MaxValue, ErrorMessage = "Please select a subscription plan.")]
        public int SubscriptionPlanId { get; set; }

        public SubscriptionTier Tier { get; set; } = SubscriptionTier.Basic;

        public BillingPeriod BillingPeriod { get; set; } = BillingPeriod.Monthly;

        [Range(typeof(decimal), "0.01", "999999999", ErrorMessage = "Amount must be greater than zero.")]
        public decimal Amount { get; set; } = 99000;

        [Required]
        [StringLength(10)]
        public string Currency { get; set; } = "VND";

        [Required]
        [StringLength(50)]
        public string PaymentProvider { get; set; } = "VnPay";

        [Required]
        [StringLength(120)]
        public string PaymentTransactionCode { get; set; } = string.Empty;
    }
}
