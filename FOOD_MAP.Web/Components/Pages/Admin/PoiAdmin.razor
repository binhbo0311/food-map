@page "/admin/poi"
@using FOOD_MAP.Shared.Data
@using FOOD_MAP.Shared.Models
@using FOOD_MAP.Shared.Services
@using Microsoft.EntityFrameworkCore
@using System.ComponentModel.DataAnnotations
@inject IDbContextFactory<AppDbContext> DbContextFactory
@inject IPoiWorkflowRepository PoiWorkflowRepository

<PageTitle>POI Admin</PageTitle>

<AdminRoleGate>

<h1>POI Admin</h1>
<p class="text-muted">Manage POI core fields and Vietnamese base translation content.</p>

<div class="d-flex flex-wrap gap-2 mb-3">
    <a class="btn btn-outline-secondary" href="/admin">Open Admin Dashboard</a>
    <a class="btn btn-outline-primary" href="/admin/requests">Review Pending Requests</a>
</div>

@if (!string.IsNullOrWhiteSpace(statusMessage))
{
    <div class="alert @(isErrorStatus ? "alert-danger" : "alert-success")" role="alert">
        @statusMessage
    </div>
}

<EditForm Model="editorModel" OnValidSubmit="HandleSubmitAsync" class="border rounded p-3 mb-3 bg-light-subtle">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="row g-3">
        <div class="col-md-6">
            <label class="form-label">Latitude</label>
            <InputNumber @bind-Value="editorModel.Latitude" class="form-control" />
        </div>
        <div class="col-md-6">
            <label class="form-label">Longitude</label>
            <InputNumber @bind-Value="editorModel.Longitude" class="form-control" />
        </div>
        <div class="col-md-6">
            <label class="form-label">Activation Radius (m)</label>
            <InputNumber @bind-Value="editorModel.ActivationRadius" class="form-control" />
        </div>
        <div class="col-md-6">
            <label class="form-label">Priority</label>
            <InputNumber @bind-Value="editorModel.Priority" class="form-control" />
        </div>
        <div class="col-md-6">
            <label class="form-label">POI Type</label>
            <InputSelect @bind-Value="editorModel.Type" class="form-select">
                <option value="@PoiType.Food">Food</option>
                <option value="@PoiType.Visit">Visit</option>
            </InputSelect>
        </div>
        <div class="col-md-6">
            <label class="form-label">Approval Status</label>
            <InputSelect @bind-Value="editorModel.ApprovalStatus" class="form-select">
                <option value="@PoiApprovalStatus.Pending">Pending</option>
                <option value="@PoiApprovalStatus.Approved">Approved</option>
                <option value="@PoiApprovalStatus.Rejected">Rejected</option>
            </InputSelect>
        </div>
        <div class="col-12">
            <label class="form-label">QRCode Id</label>
            <InputText @bind-Value="editorModel.QRCodeId" class="form-control" />
        </div>

        <div class="col-12">
            <label class="form-label">Vietnamese Name (Base)</label>
            <InputText @bind-Value="editorModel.VietnameseName" class="form-control" />
        </div>

        <div class="col-12">
            <label class="form-label">Vietnamese Description (Base)</label>
            <InputTextArea @bind-Value="editorModel.VietnameseDescription" class="form-control" rows="4" />
        </div>

        <div class="col-md-6">
            <label class="form-label">Vietnamese Image Url (Base)</label>
            <InputText @bind-Value="editorModel.VietnameseImageUrl" class="form-control" />
        </div>

        <div class="col-md-6">
            <label class="form-label">Vietnamese Audio Url (Base)</label>
            <InputText @bind-Value="editorModel.VietnameseAudioFileUrl" class="form-control" />
        </div>

        <div class="col-12">
            <label class="form-label">Vietnamese TTS Script (Base)</label>
            <InputTextArea @bind-Value="editorModel.VietnameseTtsScript" class="form-control" rows="3" />
        </div>

        <div class="col-12">
            <label class="form-label">Vietnamese Rich Content (Base, HTML/text)</label>
            <InputTextArea @bind-Value="editorModel.VietnameseRichContentHtml" class="form-control" rows="6" />
        </div>
    </div>

    <div class="d-flex gap-2 mt-3">
        <button type="submit" class="btn btn-primary" disabled="@isBusy">
            @(isEditMode ? "Update POI" : "Create POI")
        </button>
        <button type="button" class="btn btn-secondary" @onclick="ResetEditor" disabled="@isBusy">Reset</button>
    </div>
</EditForm>

<section class="border rounded p-3 mb-3 bg-white">
    <h2 class="h5 mb-3">POI Data Grid</h2>

    <div class="row g-2 mb-3">
        <div class="col-md-3">
            <label class="form-label">Search</label>
            <InputText @bind-Value="poiSearchKeyword" class="form-control" placeholder="ID, name, QR..." />
        </div>
        <div class="col-md-2">
            <label class="form-label">Type</label>
            <InputSelect @bind-Value="poiTypeFilter" class="form-select">
                <option value="">All</option>
                <option value="Food">Food</option>
                <option value="Visit">Visit</option>
            </InputSelect>
        </div>
        <div class="col-md-2">
            <label class="form-label">Status</label>
            <InputSelect @bind-Value="poiStatusFilter" class="form-select">
                <option value="">All</option>
                <option value="Pending">Pending</option>
                <option value="Approved">Approved</option>
                <option value="Rejected">Rejected</option>
            </InputSelect>
        </div>
        <div class="col-md-2">
            <label class="form-label">Sort By</label>
            <InputSelect @bind-Value="poiSortField" class="form-select">
                <option value="id">Id</option>
                <option value="name">Vietnamese Name</option>
                <option value="priority">Priority</option>
                <option value="radius">Radius</option>
                <option value="type">Type</option>
                <option value="status">Status</option>
            </InputSelect>
        </div>
        <div class="col-md-1">
            <label class="form-label">Dir</label>
            <InputSelect @bind-Value="poiSortDirection" class="form-select">
                <option value="asc">Asc</option>
                <option value="desc">Desc</option>
            </InputSelect>
        </div>
        <div class="col-md-1">
            <label class="form-label">Page Size</label>
            <InputSelect @bind-Value="poiPageSize" class="form-select">
                @foreach (var size in GridPageSizeOptions)
                {
                    <option value="@size">@size</option>
                }
            </InputSelect>
        </div>
        <div class="col-md-1 d-flex align-items-end">
            <button type="button" class="btn btn-outline-secondary w-100" @onclick="ResetPoiGridFilters">Clear</button>
        </div>
    </div>

    @{
        var filteredPoiItems = GetFilteredPoiItems();
        var poiTotalPages = GetPoiTotalPages(filteredPoiItems.Count);
        var safePoiPage = Math.Clamp(poiPageIndex, 1, poiTotalPages);
        var pagedPoiItems = filteredPoiItems
            .Skip((safePoiPage - 1) * poiPageSize)
            .Take(poiPageSize)
            .ToList();
    }

@if (isBusy)
{
    <p>Loading...</p>
}
else
{
        @if (filteredPoiItems.Count == 0)
        {
            <p class="text-muted mb-0">No POI matches current filters.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle mb-2">
                    <thead>
                        <tr>
                            <th>Id</th>
                            <th>Vietnamese Name</th>
                            <th>Latitude</th>
                            <th>Longitude</th>
                            <th>Radius</th>
                            <th>Priority</th>
                            <th>Type</th>
                            <th>Status</th>
                            <th>QRCode</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var poi in pagedPoiItems)
                        {
                            <tr>
                                <td>@poi.Id</td>
                                <td>@poi.VietnameseName</td>
                                <td>@poi.Latitude</td>
                                <td>@poi.Longitude</td>
                                <td>@poi.ActivationRadius</td>
                                <td>@poi.Priority</td>
                                <td>@poi.Type</td>
                                <td>@poi.ApprovalStatus</td>
                                <td>@poi.QRCodeId</td>
                                <td class="text-end">
                                    <button class="btn btn-sm btn-outline-primary me-2" @onclick="() => StartEdit(poi)">Edit</button>
                                    <button class="btn btn-sm btn-outline-danger" @onclick="() => DeletePoiAsync(poi.Id)">Delete</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="d-flex justify-content-between align-items-center">
                <small class="text-muted">Showing @pagedPoiItems.Count of @filteredPoiItems.Count result(s).</small>
                <div class="btn-group">
                    <button type="button"
                            class="btn btn-sm btn-outline-secondary"
                            disabled="@(safePoiPage <= 1)"
                            @onclick="() => MovePoiPage(-1)">
                        Previous
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-secondary" disabled>
                        Page @safePoiPage / @poiTotalPages
                    </button>
                    <button type="button"
                            class="btn btn-sm btn-outline-secondary"
                            disabled="@(safePoiPage >= poiTotalPages)"
                            @onclick="() => MovePoiPage(1)">
                        Next
                    </button>
                </div>
            </div>
        }
    }
</section>

</AdminRoleGate>

@code {
    private readonly List<PoiAdminRow> poiItems = [];
    private readonly PoiFormModel editorModel = new();

    private bool isBusy;
    private bool isEditMode;
    private bool isErrorStatus;
    private string? editingPoiId;
    private string poiSearchKeyword = string.Empty;
    private string poiTypeFilter = string.Empty;
    private string poiStatusFilter = string.Empty;
    private string poiSortField = "priority";
    private string poiSortDirection = "asc";
    private int poiPageSize = 10;
    private int poiPageIndex = 1;
    private string statusMessage = string.Empty;

    private static readonly int[] GridPageSizeOptions = [10, 20, 50];

    protected override async Task OnInitializedAsync()
    {
        await LoadPoiItemsAsync();
    }

    private async Task LoadPoiItemsAsync()
    {
        isBusy = true;
        statusMessage = string.Empty;

        try
        {
            await using var dbContext = await DbContextFactory.CreateDbContextAsync();
            var vietnameseLanguageId = await GetVietnameseLanguageIdAsync(dbContext);

            var items = await dbContext.Pois
                .AsNoTracking()
                .Select(x => new PoiAdminRow
                {
                    Id = x.Id,
                    Latitude = x.Latitude,
                    Longitude = x.Longitude,
                    ActivationRadius = x.ActivationRadius,
                    Priority = x.Priority,
                    Type = x.Type,
                    ApprovalStatus = x.ApprovalStatus,
                    QRCodeId = x.QRCodeId,
                    VietnameseName = x.PoiTranslations
                        .Where(t => t.LanguageId == vietnameseLanguageId)
                        .Select(t => t.LocationName)
                        .FirstOrDefault() ?? string.Empty,
                    VietnameseDescription = x.PoiTranslations
                        .Where(t => t.LanguageId == vietnameseLanguageId)
                        .Select(t => t.Description)
                        .FirstOrDefault() ?? string.Empty,
                    VietnameseImageUrl = x.PoiTranslations
                        .Where(t => t.LanguageId == vietnameseLanguageId)
                        .Select(t => t.ImageUrl)
                        .FirstOrDefault() ?? string.Empty,
                    VietnameseAudioFileUrl = x.PoiTranslations
                        .Where(t => t.LanguageId == vietnameseLanguageId)
                        .Select(t => t.AudioFileUrl)
                        .FirstOrDefault() ?? string.Empty,
                    VietnameseTtsScript = x.PoiTranslations
                        .Where(t => t.LanguageId == vietnameseLanguageId)
                        .Select(t => t.TtsScript)
                        .FirstOrDefault() ?? string.Empty,
                    VietnameseRichContentHtml = x.PoiTranslations
                        .Where(t => t.LanguageId == vietnameseLanguageId)
                        .Select(t => t.RichContentHtml)
                        .FirstOrDefault() ?? string.Empty
                })
                .OrderBy(x => x.Priority)
                .ThenBy(x => x.Id)
                .ToListAsync();

            poiItems.Clear();
            poiItems.AddRange(items);
        }
        catch (Exception ex)
        {
            // Hiển thị lỗi thao tác để người quản trị dễ kiểm tra kết nối cơ sở dữ liệu.
            isErrorStatus = true;
            statusMessage = $"Unable to load POI list: {ex.Message}";
        }
        finally
        {
            isBusy = false;
        }
    }

    private async Task HandleSubmitAsync()
    {
        if (editorModel.ActivationRadius <= 0)
        {
            isErrorStatus = true;
            statusMessage = "Activation radius must be greater than zero.";
            return;
        }

        if (editorModel.Priority <= 0)
        {
            isErrorStatus = true;
            statusMessage = "Priority must be greater than zero.";
            return;
        }

        if (string.IsNullOrWhiteSpace(editorModel.VietnameseName)
            || string.IsNullOrWhiteSpace(editorModel.VietnameseDescription)
            || string.IsNullOrWhiteSpace(editorModel.VietnameseImageUrl)
            || string.IsNullOrWhiteSpace(editorModel.VietnameseAudioFileUrl)
            || string.IsNullOrWhiteSpace(editorModel.VietnameseTtsScript))
        {
            isErrorStatus = true;
            statusMessage = "Vietnamese base translation fields are required.";
            return;
        }

        isBusy = true;
        statusMessage = string.Empty;

        try
        {
            await using var dbContext = await DbContextFactory.CreateDbContextAsync();
            var vietnameseLanguageId = await EnsureVietnameseLanguageAsync(dbContext);

            if (isEditMode && !string.IsNullOrWhiteSpace(editingPoiId))
            {
                var existingPoi = await dbContext.Pois
                    .Include(x => x.PoiTranslations)
                    .FirstOrDefaultAsync(x => x.Id == editingPoiId);

                if (existingPoi is null)
                {
                    isErrorStatus = true;
                    statusMessage = "POI no longer exists.";
                    return;
                }

                // Cập nhật thông tin POI từ biểu mẫu quản trị.
                existingPoi.Latitude = editorModel.Latitude;
                existingPoi.Longitude = editorModel.Longitude;
                existingPoi.ActivationRadius = editorModel.ActivationRadius;
                existingPoi.Priority = editorModel.Priority;
                existingPoi.Type = editorModel.Type;
                existingPoi.ApprovalStatus = editorModel.ApprovalStatus;
                existingPoi.QRCodeId = string.IsNullOrWhiteSpace(editorModel.QRCodeId) ? null : editorModel.QRCodeId.Trim();

                var vietnameseTranslation = existingPoi.PoiTranslations
                    .FirstOrDefault(x => x.LanguageId == vietnameseLanguageId);

                if (vietnameseTranslation is null)
                {
                    vietnameseTranslation = new POITranslation
                    {
                        PoiId = existingPoi.Id,
                        LanguageId = vietnameseLanguageId
                    };

                    dbContext.PoiTranslations.Add(vietnameseTranslation);
                }

                // Đồng bộ bản dịch tiếng Việt làm dữ liệu gốc để app và CMS dùng chung.
                vietnameseTranslation.LocationName = editorModel.VietnameseName.Trim();
                vietnameseTranslation.Description = editorModel.VietnameseDescription.Trim();
                vietnameseTranslation.ImageUrl = editorModel.VietnameseImageUrl.Trim();
                vietnameseTranslation.AudioFileUrl = editorModel.VietnameseAudioFileUrl.Trim();
                vietnameseTranslation.TtsScript = editorModel.VietnameseTtsScript.Trim();
                vietnameseTranslation.RichContentHtml = editorModel.VietnameseRichContentHtml.Trim();

                await dbContext.SaveChangesAsync();

                isErrorStatus = false;
                statusMessage = "POI and Vietnamese base translation updated successfully.";
            }
            else
            {
                var newPoiId = await PoiWorkflowRepository.GenerateNextPoiIdAsync(editorModel.Type);
                var newPoi = new POI
                {
                    Id = newPoiId,
                    Type = editorModel.Type,
                    Latitude = editorModel.Latitude,
                    Longitude = editorModel.Longitude,
                    ActivationRadius = editorModel.ActivationRadius,
                    Priority = editorModel.Priority,
                    QRCodeId = string.IsNullOrWhiteSpace(editorModel.QRCodeId) ? null : editorModel.QRCodeId.Trim(),
                    ApprovalStatus = editorModel.ApprovalStatus,
                    SubmittedUtc = DateTimeOffset.UtcNow,
                    ReviewedUtc = editorModel.ApprovalStatus == PoiApprovalStatus.Pending ? null : DateTimeOffset.UtcNow
                };

                dbContext.Pois.Add(newPoi);
                await dbContext.SaveChangesAsync();

                var vietnameseTranslation = new POITranslation
                {
                    PoiId = newPoi.Id,
                    LanguageId = vietnameseLanguageId,
                    LocationName = editorModel.VietnameseName.Trim(),
                    Description = editorModel.VietnameseDescription.Trim(),
                    ImageUrl = editorModel.VietnameseImageUrl.Trim(),
                    AudioFileUrl = editorModel.VietnameseAudioFileUrl.Trim(),
                    TtsScript = editorModel.VietnameseTtsScript.Trim(),
                    RichContentHtml = editorModel.VietnameseRichContentHtml.Trim()
                };

                dbContext.PoiTranslations.Add(vietnameseTranslation);
                await dbContext.SaveChangesAsync();

                isErrorStatus = false;
                statusMessage = "POI and Vietnamese base translation created successfully.";
            }

            ResetEditor();
            await LoadPoiItemsAsync();
        }
        catch (Exception ex)
        {
            // Trả thông báo rõ ràng để thuận tiện rà soát dữ liệu nhập.
            isErrorStatus = true;
            statusMessage = $"Unable to save POI: {ex.Message}";
        }
        finally
        {
            isBusy = false;
        }
    }

    private void StartEdit(PoiAdminRow poi)
    {
        editingPoiId = poi.Id;
        isEditMode = true;

        editorModel.Latitude = poi.Latitude;
        editorModel.Longitude = poi.Longitude;
        editorModel.ActivationRadius = poi.ActivationRadius;
        editorModel.Priority = poi.Priority;
        editorModel.Type = poi.Type;
        editorModel.ApprovalStatus = poi.ApprovalStatus;
        editorModel.QRCodeId = poi.QRCodeId ?? string.Empty;
        editorModel.VietnameseName = poi.VietnameseName;
        editorModel.VietnameseDescription = poi.VietnameseDescription;
        editorModel.VietnameseImageUrl = poi.VietnameseImageUrl;
        editorModel.VietnameseAudioFileUrl = poi.VietnameseAudioFileUrl;
        editorModel.VietnameseTtsScript = poi.VietnameseTtsScript;
        editorModel.VietnameseRichContentHtml = poi.VietnameseRichContentHtml;

        isErrorStatus = false;
        statusMessage = $"Editing POI #{poi.Id}";
    }

    private async Task DeletePoiAsync(string poiId)
    {
        isBusy = true;
        statusMessage = string.Empty;

        try
        {
            await using var dbContext = await DbContextFactory.CreateDbContextAsync();
            var existingPoi = await dbContext.Pois.FirstOrDefaultAsync(x => x.Id == poiId);
            if (existingPoi is null)
            {
                isErrorStatus = true;
                statusMessage = "POI no longer exists.";
                return;
            }

            dbContext.Pois.Remove(existingPoi);
            await dbContext.SaveChangesAsync();

            // Làm mới danh sách sau khi xóa để giao diện phản ánh dữ liệu mới nhất.
            if (editingPoiId == poiId)
            {
                ResetEditor();
            }

            isErrorStatus = false;
            statusMessage = "POI deleted successfully.";
            await LoadPoiItemsAsync();
        }
        catch (Exception ex)
        {
            isErrorStatus = true;
            statusMessage = $"Unable to delete POI: {ex.Message}";
        }
        finally
        {
            isBusy = false;
        }
    }

    private void ResetEditor()
    {
        editingPoiId = null;
        isEditMode = false;

        editorModel.Latitude = 0;
        editorModel.Longitude = 0;
        editorModel.ActivationRadius = 100;
        editorModel.Priority = 1;
        editorModel.Type = PoiType.Visit;
        editorModel.ApprovalStatus = PoiApprovalStatus.Approved;
        editorModel.QRCodeId = string.Empty;
        editorModel.VietnameseName = string.Empty;
        editorModel.VietnameseDescription = string.Empty;
        editorModel.VietnameseImageUrl = string.Empty;
        editorModel.VietnameseAudioFileUrl = string.Empty;
        editorModel.VietnameseTtsScript = string.Empty;
        editorModel.VietnameseRichContentHtml = string.Empty;
    }

    private List<PoiAdminRow> GetFilteredPoiItems()
    {
        IEnumerable<PoiAdminRow> query = poiItems;

        if (!string.IsNullOrWhiteSpace(poiSearchKeyword))
        {
            var keyword = poiSearchKeyword.Trim();
            query = query.Where(x =>
                x.Id.Contains(keyword, StringComparison.OrdinalIgnoreCase)
                || x.VietnameseName.Contains(keyword, StringComparison.OrdinalIgnoreCase)
                || (x.QRCodeId?.Contains(keyword, StringComparison.OrdinalIgnoreCase) ?? false));
        }

        if (!string.IsNullOrWhiteSpace(poiTypeFilter) && Enum.TryParse<PoiType>(poiTypeFilter, true, out var poiType))
        {
            query = query.Where(x => x.Type == poiType);
        }

        if (!string.IsNullOrWhiteSpace(poiStatusFilter) && Enum.TryParse<PoiApprovalStatus>(poiStatusFilter, true, out var status))
        {
            query = query.Where(x => x.ApprovalStatus == status);
        }

        var sortDescending = string.Equals(poiSortDirection, "desc", StringComparison.OrdinalIgnoreCase);
        query = poiSortField.ToLowerInvariant() switch
        {
            "id" => sortDescending ? query.OrderByDescending(x => x.Id) : query.OrderBy(x => x.Id),
            "name" => sortDescending ? query.OrderByDescending(x => x.VietnameseName) : query.OrderBy(x => x.VietnameseName),
            "radius" => sortDescending ? query.OrderByDescending(x => x.ActivationRadius) : query.OrderBy(x => x.ActivationRadius),
            "type" => sortDescending ? query.OrderByDescending(x => x.Type) : query.OrderBy(x => x.Type),
            "status" => sortDescending ? query.OrderByDescending(x => x.ApprovalStatus) : query.OrderBy(x => x.ApprovalStatus),
            _ => sortDescending ? query.OrderByDescending(x => x.Priority) : query.OrderBy(x => x.Priority)
        };

        return query.ToList();
    }

    private int GetPoiTotalPages(int totalRows)
    {
        var safePageSize = Math.Max(1, poiPageSize);
        return Math.Max(1, (int)Math.Ceiling(totalRows / (double)safePageSize));
    }

    private void MovePoiPage(int delta)
    {
        var totalPages = GetPoiTotalPages(GetFilteredPoiItems().Count);
        poiPageIndex = Math.Clamp(poiPageIndex + delta, 1, totalPages);
    }

    private void ResetPoiGridFilters()
    {
        poiSearchKeyword = string.Empty;
        poiTypeFilter = string.Empty;
        poiStatusFilter = string.Empty;
        poiSortField = "priority";
        poiSortDirection = "asc";
        poiPageSize = 10;
        poiPageIndex = 1;
    }

    private static async Task<int> GetVietnameseLanguageIdAsync(AppDbContext dbContext)
    {
        return await dbContext.Languages
            .Where(x => x.LanguageCode == "vi")
            .Select(x => x.Id)
            .FirstOrDefaultAsync();
    }

    private static async Task<int> EnsureVietnameseLanguageAsync(AppDbContext dbContext)
    {
        var language = await dbContext.Languages.FirstOrDefaultAsync(x => x.LanguageCode == "vi");
        if (language is not null)
        {
            return language.Id;
        }

        // Tạo ngôn ngữ tiếng Việt nếu chưa có để đảm bảo POI luôn có dữ liệu nền.
        var vietnameseLanguage = new Language
        {
            LanguageCode = "vi",
            LanguageName = "Tiếng Việt"
        };

        dbContext.Languages.Add(vietnameseLanguage);
        await dbContext.SaveChangesAsync();
        return vietnameseLanguage.Id;
    }

    private sealed class PoiAdminRow
    {
        public string Id { get; set; } = string.Empty;

        public double Latitude { get; set; }

        public double Longitude { get; set; }

        public int ActivationRadius { get; set; }

        public int Priority { get; set; }

        public PoiType Type { get; set; }

        public PoiApprovalStatus ApprovalStatus { get; set; }

        public string? QRCodeId { get; set; }

        public string VietnameseName { get; set; } = string.Empty;

        public string VietnameseDescription { get; set; } = string.Empty;

        public string VietnameseImageUrl { get; set; } = string.Empty;

        public string VietnameseAudioFileUrl { get; set; } = string.Empty;

        public string VietnameseTtsScript { get; set; } = string.Empty;

        public string VietnameseRichContentHtml { get; set; } = string.Empty;
    }

    private sealed class PoiFormModel
    {
        public double Latitude { get; set; }

        public double Longitude { get; set; }

        public int ActivationRadius { get; set; } = 100;

        public int Priority { get; set; } = 1;

        public PoiType Type { get; set; } = PoiType.Visit;

        public PoiApprovalStatus ApprovalStatus { get; set; } = PoiApprovalStatus.Approved;

        public string QRCodeId { get; set; } = string.Empty;

        [Required]
        public string VietnameseName { get; set; } = string.Empty;

        [Required]
        public string VietnameseDescription { get; set; } = string.Empty;

        [Required]
        public string VietnameseImageUrl { get; set; } = string.Empty;

        [Required]
        public string VietnameseAudioFileUrl { get; set; } = string.Empty;

        [Required]
        public string VietnameseTtsScript { get; set; } = string.Empty;

        public string VietnameseRichContentHtml { get; set; } = string.Empty;
    }
}
